# AI provider keys for the headless authoring harness (AIX-002 spec step 2).
#
# Copy to .env (gitignored) and fill in what you have. The in-editor Build
# panel does NOT read this file — configure that in Editor Settings, where
# keys are stored OS-encrypted. This file exists only for terminal-run
# measurement harnesses that construct providers directly.
#
# Never commit a real key. `.env` is in .gitignore; this example must stay
# placeholder-only.

# Anthropic — the primary measurement target (streams tool-call partials,
# priced in the model registry so cost metrics come out non-null).
ANTHROPIC_API_KEY=

# OpenAI — optional, cross-provider validation of the same loop.
OPENAI_API_KEY=

# OpenAI-compatible gateway — optional. Set both if you use one.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Ollama needs no key; if it is not at the default localhost:11434, set:
OLLAMA_BASE_URL=
