{
  "name": "@nodegx/export",
  "version": "0.0.1",
  "description": "Code export for NodeGX projects: v2 files → IR → analysis → generated React. EXP-002's pipeline; the IR is the shared contract with EXP-003/005 (dev-docs/tasks/phase-18-code-export-v2/EXP-002-IR-DESIGN.md).",
  "author": "The Low Code Foundation <contact@thelowcodefoundation.com>",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Low-Code-Foundation/NodeGX.git",
    "directory": "packages/nodegx-export"
  },
  "bin": {
    "nodegx": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.mjs",
      "require": "./dist/ledger.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nodegx/module-inject": "file:../nodegx-module-inject",
    "@nodegx/project-contract": "file:../nodegx-project-contract",
    "@types/jest": "^29.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
