{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e45ee29e-0329-454f-a028-0f47dcdd606d",
  "version": 1,
  "nodes": [
    {
      "id": "notesPage",
      "type": "Page",
      "label": "Notes",
      "x": 40,
      "y": 40,
      "children": [
        "notesShell"
      ],
      "parameters": {
        "title": "Notes",
        "urlPath": "notes"
      }
    },
    {
      "id": "notesShell",
      "type": "Group",
      "label": "Shell",
      "x": 100,
      "y": 160,
      "parent": "notesPage",
      "children": [
        "notesHeading",
        "entryInput",
        "addButton",
        "notesList"
      ],
      "parameters": {
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-4)",
        "maxWidth": {
          "value": 640,
          "unit": "px"
        },
        "paddingTop": "var(--space-10)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      }
    },
    {
      "id": "notesHeading",
      "type": "Text",
      "label": "Heading",
      "x": 160,
      "y": 280,
      "parent": "notesShell",
      "parameters": {
        "text": "Notes",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)"
      }
    },
    {
      "id": "entryInput",
      "type": "net.noodl.controls.textinput",
      "label": "Draft",
      "x": 160,
      "y": 400,
      "parent": "notesShell",
      "parameters": {
        "placeholder": "What happened?",
        "borderColor": "var(--border)",
        "backgroundColor": "var(--background)",
        "borderRadius": "var(--radius-md)",
        "fontSize": "var(--text-base)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)"
      }
    },
    {
      "id": "addButton",
      "type": "net.noodl.controls.button",
      "label": "Add note",
      "x": 160,
      "y": 520,
      "parent": "notesShell",
      "parameters": {
        "label": "Add note",
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      }
    },
    {
      "id": "notesList",
      "type": "For Each",
      "label": "One row per note",
      "x": 160,
      "y": 640,
      "parent": "notesShell",
      "parameters": {
        "template": "/Components/NoteRow"
      }
    },
    {
      "id": "noteDraftVar",
      "type": "Variable2",
      "label": "noteDraft variable",
      "x": 410,
      "y": 400,
      "parameters": {
        "name": "noteDraft"
      }
    },
    {
      "id": "makeNote",
      "type": "NewModel",
      "label": "Make note",
      "x": 410,
      "y": 520,
      "parameters": {
        "properties": "text,mood",
        "prop-mood": "sunny",
        "type-text": "string",
        "type-mood": "string"
      }
    },
    {
      "id": "insertNote",
      "type": "CollectionInsert",
      "label": "Insert note",
      "x": 610,
      "y": 520,
      "parameters": {
        "collectionId": "notes"
      }
    },
    {
      "id": "notesArray",
      "type": "Collection2",
      "label": "Notes array",
      "x": 410,
      "y": 640,
      "parameters": {
        "collectionId": "notes"
      }
    }
  ],
  "visualRoots": [
    "notesPage"
  ]
}