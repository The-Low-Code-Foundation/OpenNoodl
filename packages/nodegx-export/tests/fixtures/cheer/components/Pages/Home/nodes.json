{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "fc889956-7d22-40c0-b344-a1f391cfed60",
  "version": 1,
  "nodes": [
    {
      "id": "page",
      "type": "Page",
      "label": "Home",
      "children": [
        "shell"
      ],
      "parameters": {
        "title": "Cheer",
        "urlPath": "home"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "shell",
      "type": "Group",
      "label": "Shell",
      "children": [
        "headline",
        "nameInput",
        "visitorBadge",
        "cheerButton",
        "cheerBanner"
      ],
      "parameters": {
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-4)",
        "maxWidth": {
          "value": 640,
          "unit": "px"
        },
        "paddingTop": "var(--space-10)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      },
      "parent": "page",
      "x": 100,
      "y": 160
    },
    {
      "id": "headline",
      "type": "Text",
      "label": "Headline",
      "parent": "shell",
      "parameters": {
        "text": "Cheer for a visitor",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "nameInput",
      "type": "net.noodl.controls.textinput",
      "label": "Visitor name",
      "parent": "shell",
      "parameters": {
        "placeholder": "Type a visitor name",
        "borderColor": "var(--border)",
        "backgroundColor": "var(--background)",
        "borderRadius": "var(--radius-md)",
        "fontSize": "var(--text-base)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "visitorBadge",
      "type": "/Components/GreetingBadge",
      "label": "Greeting badge",
      "parent": "shell",
      "x": 160,
      "y": 520
    },
    {
      "id": "cheerButton",
      "type": "net.noodl.controls.button",
      "label": "Cheer",
      "parent": "shell",
      "parameters": {
        "label": "Cheer",
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "cheerBanner",
      "type": "/Components/CheerBanner",
      "label": "Cheer banner",
      "parent": "shell",
      "x": 160,
      "y": 760
    },
    {
      "id": "visitorVar",
      "type": "Variable2",
      "label": "visitorName variable",
      "parameters": {
        "name": "visitorName"
      },
      "x": 410,
      "y": 400
    },
    {
      "id": "cheerSend",
      "type": "Event Sender",
      "label": "Broadcast celebrate",
      "parameters": {
        "channelName": "celebrate",
        "payload": "message"
      },
      "x": 410,
      "y": 640
    }
  ],
  "visualRoots": [
    "page"
  ]
}