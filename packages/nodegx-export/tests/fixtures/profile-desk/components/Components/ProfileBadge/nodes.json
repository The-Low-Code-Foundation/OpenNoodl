{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "pr0f11e5-4e1a-4b3e-9f2a-1a2b3c4d6e03",
  "version": 1,
  "nodes": [
    {
      "id": "badge-root",
