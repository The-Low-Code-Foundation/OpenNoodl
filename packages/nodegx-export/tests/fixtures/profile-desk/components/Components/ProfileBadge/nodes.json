      "parameters": {
        "fontSize": "var(--text-sm)",
        "color": "var(--foreground)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "badge-profile",
      "type": "Model2",
      "label": "Profile object",
      "x": 350,
      "y": 160,
      "parameters": {
        "idSource": "explicit",
        "modelId": "profile",
        "properties": "name"
      }
    }
