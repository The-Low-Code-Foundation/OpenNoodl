    {
      "id": "ticker",
      "type": "Javascript2",
      "label": "Ticker",
      "parameters": {
        "code": "let timerId;\nlet seconds = 0;\n\nfunction format() {\n  let minutes = Math.floor(seconds / 60);\n  let remainingSeconds = seconds % 60;\n  let formattedSeconds = remainingSeconds < 10 ? '0' + remainingSeconds : remainingSeconds;\n  return `${minutes}:${formattedSeconds}`;\n}\n\nScript.Signals.Start = async function () {\n  if (timerId) {\n    return;\n  }\n\n  seconds = 0; // Reset the seconds\n  Script.Outputs.Seconds = \"0:00\";\n\n  timerId = setInterval(() => {\n    seconds++;\n    Script.Outputs.Seconds = format();\n  }, 1000);\n}\n\nScript.Signals.Stop = async function () {\n  if (timerId) {\n    clearInterval(timerId);\n    timerId = null;\n    Script.Outputs.Seconds = format();\n  }\n}\n"
      },
      "dynamicports": [
        {
          "name": "Start",
          "plug": "input",
          "type": {
            "name": "signal"
          },
          "group": "Inputs",
          "index": 5
