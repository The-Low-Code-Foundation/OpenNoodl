{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e7a1c4d2-5b3f-4e8d-9c1a-000000000099",
  "version": 1,
  "nodes": [
    {
      "id": "introRoot",
      "type": "Group",
      "label": "Intro",
      "children": [
        "introTitle",
        "emailInput",
        "nextBtn",
        "cameBackText"
      ],
      "parameters": {
        "flexDirection": "column",
        "rowGap": "var(--space-2)"
      },
      "x": 100,
      "y": 100
    },
    {
      "id": "introTitle",
      "type": "Text",
      "label": "Title",
      "parent": "introRoot",
      "parameters": {
        "text": "Step 1 - your email",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 200
    },
    {
      "id": "emailInput",
      "type": "net.noodl.controls.textinput",
      "label": "Email",
      "parent": "introRoot",
      "parameters": {
        "placeholder": "you@example.com"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "nextBtn",
      "type": "net.noodl.controls.button",
      "label": "Next",
      "parent": "introRoot",
      "parameters": {
        "label": "Next"
      },
      "x": 100,
      "y": 360
    },
    {
      "id": "cameBackText",
      "type": "Text",
      "label": "Came back",
      "parent": "introRoot",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 440
    },
    {
      "id": "pushDetails",
      "type": "PageStackNavigate",
      "label": "Push details",
      "parameters": {
        "stack": "Main",
        "target": "details"
      },
      "x": 400,
      "y": 360
    },
    {
      "id": "setConfirmed",
      "type": "Set Variable",
      "label": "Remember confirmed",
      "parameters": {
        "name": "confirmedEmail"
      },
      "x": 700,
      "y": 360
    },
    {
      "id": "draftVar",
      "type": "Variable2",
      "label": "Draft email",
      "parameters": {
        "name": "draftEmail"
      },
      "x": 400,
      "y": 280
    }
  ],
  "visualRoots": [
    "introRoot"
  ]
}
