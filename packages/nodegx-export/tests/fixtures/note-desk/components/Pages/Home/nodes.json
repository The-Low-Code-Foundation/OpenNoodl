{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "6e0d3b74-5a91-4c26-b8f7-1e4a92d05f38",
  "version": 1,
  "nodes": [
    {
      "id": "homePage",
      "type": "Page",
      "label": "Note Desk",
      "children": [
        "shell"
      ],
      "parameters": {
        "title": "Note Desk",
        "urlPath": "home"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "shell",
      "type": "Group",
      "label": "Shell",
      "parent": "homePage",
      "children": [
        "heading",
        "noteInput",
        "addButton",
        "noteList",
        "statusText"
      ],
      "parameters": {
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-4)",
        "maxWidth": {
          "value": 640,
          "unit": "px"
        },
        "paddingTop": "var(--space-10)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "heading",
      "type": "Text",
      "label": "Heading",
      "parent": "shell",
      "parameters": {
        "text": "Note Desk",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "noteInput",
      "type": "net.noodl.controls.textinput",
      "label": "Note",
      "parent": "shell",
      "parameters": {
        "placeholder": "What happened?",
        "borderColor": "var(--border)",
        "backgroundColor": "var(--background)",
        "borderRadius": "var(--radius-md)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "addButton",
      "type": "net.noodl.controls.button",
      "label": "Add note",
      "parent": "shell",
      "parameters": {
        "label": "Add note",
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "noteList",
      "type": "For Each",
      "label": "One row per note",
      "parent": "shell",
      "parameters": {
        "template": "/Components/NoteRow"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "statusText",
      "type": "Text",
      "label": "Status",
      "parent": "shell",
      "parameters": {
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 760
    },
    {
      "id": "noteVar",
      "type": "Variable2",
      "label": "noteDraft variable",
      "parameters": {
        "name": "noteDraft"
      },
      "x": 410,
      "y": 400
    },
    {
      "id": "makeNote",
      "type": "NewModel",
      "label": "Make note",
      "parameters": {
        "properties": "text",
        "type-text": "string"
      },
      "x": 410,
      "y": 520
    },
    {
      "id": "insertNote",
      "type": "CollectionInsert",
      "label": "Insert note",
      "parameters": {
        "collectionId": "notes"
      },
      "x": 410,
      "y": 640
    },
    {
      "id": "notesArray",
      "type": "Collection2",
      "label": "Notes array",
      "parameters": {
        "collectionId": "notes"
      },
      "x": 410,
      "y": 760
    },
    {
      "id": "removeNote",
      "type": "CollectionRemove",
      "label": "Remove the row that was clicked",
      "parameters": {
        "collectionId": "notes"
      },
      "x": 410,
      "y": 880
    },
    {
      "id": "removedVar",
      "type": "Set Variable",
      "label": "Say it went",
      "parameters": {
        "name": "lastAction"
      },
      "x": 410,
      "y": 1000
    },
    {
      "id": "removedLabel",
      "type": "String",
      "label": "Removed wording",
      "parameters": {
        "value": "Removed a note."
      },
      "x": 410,
      "y": 1120
    },
    {
      "id": "statusVar",
      "type": "Variable2",
      "label": "lastAction variable",
      "parameters": {
        "name": "lastAction"
      },
      "x": 410,
      "y": 1240
    }
  ],
  "visualRoots": [
    "homePage"
  ]
}
