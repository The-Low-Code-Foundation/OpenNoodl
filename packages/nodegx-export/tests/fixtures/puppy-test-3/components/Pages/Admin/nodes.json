    {
      "id": "formatList",
      "type": "JavaScriptFunction",
      "label": "Format Puppy List",
      "x": 150,
      "y": 680,
      "parameters": {
        "functionScript": "const list = Inputs.items || [];\nOutputs.text = list.map(p => `${p.id || p.objectId} — ${p['prop-name'] || p.name} (${p['prop-breed'] || p.breed}, ${p['prop-age'] || p.age})`).join('\\n') || 'No puppies yet.';"
      },
      "dynamicports": [
        {
          "name": "in-items",
          "displayName": "items",
          "plug": "input",
          "type": "*",
          "group": "Inputs",
          "index": 10
        },
        {
          "name": "out-text",
          "displayName": "text",
          "plug": "output",
          "type": "*",
