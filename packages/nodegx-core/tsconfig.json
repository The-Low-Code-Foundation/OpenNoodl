{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    // Strict throughout, unlike the root program. This package is published and its types are the
    // API surface every exported project sees; `noImplicitAny: false` at the root is a legacy
    // accommodation this package has no reason to inherit.
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
