  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "serve": "node bin/nodegx-backend.js serve",
    "doctor": "node bin/nodegx-backend.js doctor",
    "test": "jest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@noodl/runtime": "file:../noodl-runtime"
  },
  "devDependencies": {
    "@types/jest": "^29.0.1",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3"
  }
