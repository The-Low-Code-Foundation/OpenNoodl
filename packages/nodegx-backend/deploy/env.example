# NodeGX self-hosting — copy to `.env` beside docker-compose.yml and edit.
#
#   cp env.example .env
#
# `.env` is read by Docker Compose only. It is NOT copied into any image and is
# excluded from the build context by .dockerignore — scripts/package-deploy.js
# fails the build if a file like this ever turns up inside an artifact.

# ---------------------------------------------------------------------------
# Where the stack is served
# ---------------------------------------------------------------------------

# Host port for the whole stack (app + API + /_admin share it).
NODEGX_HTTP_PORT=8080

# Host interface to publish on. Leave 0.0.0.0 for a directly-reachable box; set
# 127.0.0.1 if a reverse proxy on the same host terminates TLS in front.
NODEGX_BIND=0.0.0.0

# The build id to run. `./nodegx-deploy.sh build` prints one and writes it here;
# `./nodegx-deploy.sh rollback <id>` sets it back to a previous value.
NODEGX_TAG=dev

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Doubles as the accepted X-Parse-Application-Id. It must match the app id the
# editor baked into the application bundle (Backend Services -> App ID).
NODEGX_BACKEND_ID=nodegx-backend
NODEGX_BACKEND_NAME=NodeGX Backend

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
#
# The admin credential unlocks the dashboard at /_admin and every /admin route.
#
# Leave BOTH of these empty for a first deploy: the backend mints a credential,
# writes it to /data/secrets.json (mode 0600) inside the volume, and prints
# where to find it —
#
#   docker compose logs backend | grep -A3 "FIRST RUN"
#   docker compose exec backend cat /data/secrets.json
#
# To choose your own, prefer the _FILE form: put the secret in ./secrets/admin_token,
# uncomment the `secrets:` blocks in docker-compose.yml, and set
#   NODEGX_ADMIN_TOKEN_FILE=/run/secrets/nodegx_admin_token
# That keeps it out of this file, out of the image, and out of `docker inspect`.
#
# NODEGX_ADMIN_TOKEN is the plain fallback. It is read by the container at
# startup and passed to the CLI, so it is visible in the container's process
# arguments — acceptable on a box you control, not equivalent to a secret file.
NODEGX_ADMIN_TOKEN=
NODEGX_ADMIN_TOKEN_FILE=

# Optional second credential that can read everything the dashboard shows and
# change nothing (BAK-005). Never minted automatically.
NODEGX_READONLY_TOKEN_FILE=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Set false to not route /_admin at all (it 404s like any unknown path).
NODEGX_ADMIN_DASHBOARD=true
