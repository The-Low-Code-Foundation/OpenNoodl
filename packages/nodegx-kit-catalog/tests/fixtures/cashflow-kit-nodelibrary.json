          "plug": "input",
          "group": "General",
          "displayName": "Mounted",
          "description": "Removes the element from the page entirely when false, unlike Visible which leaves its space behind",
          "default": true,
          "index": 9999
        },
        {
          "name": "days",
          "type": "number",
          "plug": "input",
          "group": "Track",
          "displayName": "Days",
          "default": 31
        },
        {
          "name": "laneHeight",
          "type": "number",
          "plug": "input",
          "group": "Style",
          "displayName": "Lane Height",
          "default": 30
