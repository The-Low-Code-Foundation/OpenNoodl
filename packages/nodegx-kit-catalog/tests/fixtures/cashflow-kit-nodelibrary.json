      "module": "Cashflow Kit",
      "allowAsChild": true,
      "allowAsExportRoot": true,
      "color": "visual",
      "allowChildrenWithCategory": [
        "Visual"
      ],
      "docs": "A one-row day track. Measures itself and outputs the pixel width of a single day.",
      "category": "Visual",
      "useVariants": true,
      "ports": [
        {
          "name": "cssClassName",
          "type": "string",
