    {
      "id": "swToFreelancer",
      "type": "RouterNavigate",
      "label": "Go to the freelancer look",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Freelancer"
      },
      "x": 470,
      "y": 520
    },
    {
      "id": "swToBusiness",
      "type": "RouterNavigate",
      "label": "Go to the local business look",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Business"
      },
      "x": 470,
      "y": 640
    },
    {
      "id": "swToLaunch",
      "type": "RouterNavigate",
      "label": "Go to the product launch look",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Launch"
      },
      "x": 470,
      "y": 760
    }
  ],
  "visualRoots": [
    "swStrip"
  ]
}
