{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "abb8e784-af7f-5144-8a02-34fe62128f37",
  "version": 1,
  "nodes": [
    {
      "id": "fqRow",
      "type": "Group",
      "label": "One question",
      "children": [
        "fqHead",
        "fqAnswer"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "flex-start",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "borderBottomColor": "var(--border-subtle)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)",
        "rowGap": "var(--space-2)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "fqHead",
      "type": "Group",
      "label": "The question, and the chevron",
      "parent": "fqRow",
      "children": [
        "fqQuestion",
        "fqChevron"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "alignItems": "flex-start",
        "justifyContent": "space-between",
        "columnGap": "var(--space-4)",
        "cssClassName": "disclosure"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "fqQuestion",
      "type": "Text",
      "label": "The question",
      "parent": "fqHead",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-lg)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)",
        "as": "h3"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "fqChevron",
      "type": "net.noodl.visual.icon",
      "label": "Open or closed",
      "parent": "fqHead",
      "parameters": {
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-chevron-down",
          "codeAsClass": true
        },
        "iconSize": {
          "value": 20,
          "unit": "px"
        },
        "iconColor": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "fqAnswer",
      "type": "Text",
      "label": "The answer",
      "parent": "fqRow",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "color": "var(--muted-foreground)",
        "mounted": false
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "fqStates",
      "type": "States",
      "label": "Closed / open",
      "parameters": {
        "states": "closed,open",
        "values": "chevron",
        "type-chevron": "number",
        "value-closed-chevron": 0,
        "value-open-chevron": 180,
        "useTransitions": true
      },
      "x": 410,
      "y": 520
    },
    {
      "id": "fqInputs",
      "type": "Component Inputs",
      "label": "The question",
      "ports": [
        {
          "name": "question",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "answer",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 280
    }
  ],
  "visualRoots": [
    "fqRow"
  ]
}
