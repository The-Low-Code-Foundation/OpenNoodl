      "id": "ctHintText",
      "type": "Expression",
      "label": "What the line under Send says",
      "parameters": {
        "expression": "ok ? \"Send opens your mail app with the message written for you.\" : \"Fill in your name, your email and a few lines, and Send will light up.\""
