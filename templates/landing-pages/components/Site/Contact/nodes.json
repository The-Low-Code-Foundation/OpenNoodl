      "x": 590,
      "y": 1240
    },
    {
      "id": "ctEmailCheck",
      "type": "/Site/IsValidEmail",
      "label": "Is the address one you could reply to?",
      "x": 590,
      "y": 1480
    },
    {
      "id": "ctMsgOk",
      "type": "Expression",
      "label": "Is the message long enough?",
      "parameters": {
        "expression": "(m || '').trim().length >= 20"
