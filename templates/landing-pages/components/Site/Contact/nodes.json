      "x": 590,
      "y": 1960
    },
    {
      "id": "ctMsgHelper",
      "type": "Expression",
      "label": "How much more is needed",
      "parameters": {
        "expression": "(m || '').trim().length >= 20 ? 'That is plenty — go ahead.' : ('About ' + (20 - (m || '').trim().length) + ' more characters, please.')"
      },
