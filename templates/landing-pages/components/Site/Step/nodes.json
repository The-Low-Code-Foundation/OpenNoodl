{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "c945fa23-eb27-55a2-8b2e-e96d5943de27",
  "version": 1,
  "nodes": [
    {
      "id": "stItem",
      "type": "Group",
      "label": "One step",
      "children": [
        "stBadge",
        "stWords"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "columnGap": "var(--space-3)",
        "alignItems": "flex-start"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "stBadge",
      "type": "Group",
      "label": "The number",
      "parent": "stItem",
      "children": [
        "stNumber"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 44,
          "unit": "px"
        },
        "height": {
          "value": 44,
          "unit": "px"
        },
        "flexDirection": "column",
        "alignItems": "center",
        "justifyContent": "center",
        "backgroundColor": "var(--accent)",
        "borderRadius": "var(--radius-full)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "stNumber",
      "type": "Text",
      "label": "Which step",
      "parent": "stBadge",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-bold)",
        "letterSpacing": "var(--tracking-wide)",
        "color": "var(--accent-foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "stWords",
      "type": "Group",
      "label": "The words",
      "parent": "stItem",
      "children": [
        "stTitle",
        "stLine"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-1)"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "stTitle",
      "type": "Text",
      "label": "What happens",
      "parent": "stWords",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)",
        "as": "h3"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "stLine",
      "type": "Text",
      "label": "How",
      "parent": "stWords",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "stInputs",
      "type": "Component Inputs",
      "label": "The step",
      "ports": [
        {
          "name": "number",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "line",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 280
    }
  ],
  "visualRoots": [
    "stItem"
  ]
}
