{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "0b28b322-ab7e-5f7a-879e-0125d32b3d3d",
  "version": 1,
  "nodes": [
    {
      "id": "pcCard",
      "type": "Group",
      "label": "One card",
      "children": [
        "pcPhoto",
        "pcBody"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column",
        "cssClassName": "card-lift photo-zoom"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "pcPhoto",
      "type": "Image",
      "label": "The photograph",
      "parent": "pcCard",
      "parameters": {
        "sizeMode": "explicit",
        "objectFit": "cover",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "height": {
          "value": 220,
          "unit": "px"
        },
        "src": "",
        "alt": ""
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "pcBody",
      "type": "Group",
      "label": "The words",
      "parent": "pcCard",
      "children": [
        "pcHead",
        "pcLine",
        "pcDetail"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-2)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "pcHead",
      "type": "Group",
      "label": "The title, and the chevron",
      "parent": "pcBody",
      "children": [
        "pcTitle",
        "pcChevron"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "alignItems": "center",
        "justifyContent": "space-between",
        "columnGap": "var(--space-3)",
        "cssClassName": "disclosure"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "pcTitle",
      "type": "Text",
      "label": "What it is",
      "parent": "pcHead",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)",
        "as": "h3"
      },
      "x": 220,
      "y": 520
    },
    {
      "id": "pcChevron",
      "type": "net.noodl.visual.icon",
      "label": "Open or closed",
      "parent": "pcHead",
      "parameters": {
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-chevron-down",
          "codeAsClass": true
        },
        "iconSize": {
          "value": 18,
          "unit": "px"
        },
        "iconColor": "var(--muted-foreground)"
      },
      "x": 220,
      "y": 640
    },
    {
      "id": "pcLine",
      "type": "Text",
      "label": "A line about it",
      "parent": "pcBody",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 760
    },
    {
      "id": "pcDetail",
      "type": "Text",
      "label": "The rest of it",
      "parent": "pcBody",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "color": "var(--muted-foreground)",
        "mounted": false
      },
      "x": 160,
      "y": 880
    },
    {
      "id": "pcStates",
      "type": "States",
      "label": "Closed / open",
      "parameters": {
        "states": "closed,open",
        "values": "chevron",
        "type-chevron": "number",
        "value-closed-chevron": 0,
        "value-open-chevron": 180,
        "useTransitions": true
      },
      "x": 470,
      "y": 880
    },
    {
      "id": "pcInputs",
      "type": "Component Inputs",
      "label": "The card",
      "ports": [
        {
          "name": "picture",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "alt",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "line",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "detail",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 470,
      "y": 160
    }
  ],
  "visualRoots": [
    "pcCard"
  ]
}
