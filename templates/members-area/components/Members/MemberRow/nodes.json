      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "describe",
      "type": "JavaScriptFunction",
      "label": "Say what they are, and since when, in English",
      "parameters": {
        "functionScript": "if (Inputs.standing === undefined) return;\nconst LABELS = {\"moderator\":\"Moderator\",\"member\":\"Member\"};\nconst standing = Inputs.standing === null ? '' : String(Inputs.standing);\n// ⚠️ An unknown standing falls back to the stored word rather than to\n// an empty line: a row that says `trustee` is legible, and a row that\n// says nothing at all is the bug that hides the new standing nobody\n// added a label for.\nconst label = LABELS[standing] || standing;\nconst joined = Inputs.joinedAt === undefined || Inputs.joinedAt === null ? '' : String(Inputs.joinedAt);\n// The column is a full ISO timestamp; the day is what a person wants.\nconst day = joined.length >= 10 ? joined.slice(0, 10) : '';\nOutputs.description = day.length > 0 ? label + ' · since ' + day : label;"
      },
      "x": 350,
      "y": 400
    }
  ],
  "visualRoots": [
    "row-4"
  ]
