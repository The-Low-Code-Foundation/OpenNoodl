{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e5bb1e4c-fadd-5352-81b5-645c1ccf6a52",
  "version": 1,
  "nodes": [
    {
      "id": "tile",
      "type": "Group",
      "label": "One tile",
      "children": [
        "tilePhoto",
        "tileBody"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "tilePhoto",
      "type": "Image",
      "label": "The photograph",
      "parent": "tile",
      "parameters": {
        "sizeMode": "explicit",
        "objectFit": "cover",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "height": {
          "value": 200,
          "unit": "px"
        },
        "src": "",
        "alt": ""
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "tileBody",
      "type": "Group",
      "label": "The words",
      "parent": "tile",
      "children": [
        "tileTitle",
        "tileLine"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "column",
        "rowGap": "var(--space-2)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)",
        "sizeMode": "contentHeight"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "tileTitle",
      "type": "Text",
      "label": "What it is",
      "parent": "tileBody",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "tileLine",
      "type": "Text",
      "label": "What it holds",
      "parent": "tileBody",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "inputs-6",
      "type": "Component Inputs",
      "label": "The tile",
      "ports": [
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "line",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "picture",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "alt",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 400
    }
  ],
  "visualRoots": [
    "tile"
  ]
}
