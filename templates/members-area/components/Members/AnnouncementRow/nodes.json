        }
      ],
      "x": 410,
      "y": 280
    },
    {
      "id": "when",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "function humanDay(raw) {\n  if (raw === undefined || raw === null) return '';\n  var s = String(raw);\n  if (s === '') return '';\n  var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s);\n  var at = m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : new Date(s);\n  if (isNaN(at.getTime())) return '';\n  return at.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });\n}\nif (Inputs.postedAt === undefined) return;\nOutputs.label = humanDay(Inputs.postedAt);"
      },
      "x": 410,
      "y": 520,
      "ports": [
        {
          "name": "in-postedAt",
          "displayName": "postedAt",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-label",
          "displayName": "label",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "firstLine",
      "type": "JavaScriptFunction",
      "label": "The first line of the body, and only the first",
      "parameters": {
        "runOnChange-in-body": false,
        "functionScript": "if (Inputs.body === undefined) return;\nconst flat = String(Inputs.body || '').replace(/\\s+/g, ' ').trim();\nif (flat.length <= 120) {\n  Outputs.line = flat;\n  return;\n}\nconst cut = flat.slice(0, 120);\nconst lastSpace = cut.lastIndexOf(\" \");\nOutputs.line = (lastSpace > 60 ? cut.slice(0, lastSpace) : cut) + '…';"
      },
      "x": 410,
      "y": 400,
      "ports": [
        {
          "name": "in-body",
          "displayName": "body",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-line",
          "displayName": "line",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
