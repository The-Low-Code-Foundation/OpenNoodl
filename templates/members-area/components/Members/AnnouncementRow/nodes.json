{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "4f5c2adb-068c-5a26-863a-ab66de012c6b",
  "version": 1,
  "nodes": [
    {
      "id": "row",
      "type": "Group",
      "label": "One announcement",
      "children": [
        "rowTitle",
        "rowDate",
        "readButton"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column",
        "rowGap": "var(--space-2)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)",
        "marginBottom": "var(--space-4)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "rowTitle",
      "type": "Text",
      "label": "Title",
      "parent": "row",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "rowDate",
      "type": "Text",
      "label": "Posted",
      "parent": "row",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "readButton",
      "type": "net.noodl.controls.button",
      "label": "Read",
      "parent": "row",
      "parameters": {
        "label": "Read",
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "inputs-2",
      "type": "Component Inputs",
      "label": "The announcement",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "postedAt",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "when",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "function humanDay(raw) {\n  if (raw === undefined || raw === null) return '';\n  var s = String(raw);\n  if (s === '') return '';\n  var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s);\n  var at = m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : new Date(s);\n  if (isNaN(at.getTime())) return '';\n  return at.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });\n}\nif (Inputs.postedAt === undefined) return;\nOutputs.label = humanDay(Inputs.postedAt);"
      },
      "x": 350,
      "y": 280
    },
    {
      "id": "goDetail",
      "type": "RouterNavigate",
      "label": "Open the announcement",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Announcement"
      },
      "x": 350,
      "y": 400
    }
  ],
  "visualRoots": [
    "row"
  ]
}
