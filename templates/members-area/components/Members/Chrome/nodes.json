    {
      "id": "bandShape",
      "type": "JavaScriptFunction",
      "label": "Is there room for the six ways on, or do they go behind a menu?",
      "parameters": {
        "runOnChange-in-width": true,
        "runOnChange-in-signedIn": true,
        "runOnChange-in-open": true,
        "functionScript": "const narrow = Inputs.width !== undefined && Inputs.width < 700;\nconst signedIn = Inputs.signedIn === true;\nOutputs.menuMounted = signedIn && narrow;\nOutputs.navMounted = signedIn && (!narrow || Inputs.open === true);"
      },
      "x": 530,
      "y": 1120,
      "ports": [
        {
          "name": "in-width",
          "displayName": "width",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-signedIn",
          "displayName": "signedIn",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-open",
          "displayName": "open",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-menuMounted",
          "displayName": "menuMounted",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-navMounted",
          "displayName": "navMounted",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
