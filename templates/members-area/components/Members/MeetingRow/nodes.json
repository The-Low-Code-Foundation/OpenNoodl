      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "if (Inputs.when === undefined) return;\nconst raw = Inputs.when || '';\nconst at = new Date(raw);\nOutputs.label = isNaN(at.getTime()) ? raw : at.toLocaleDateString();"
      },
      "x": 350,
      "y": 280
    },
