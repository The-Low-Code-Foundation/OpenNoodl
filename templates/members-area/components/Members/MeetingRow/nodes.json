    {
      "id": "whenLabel",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "function humanDay(raw) {\n  if (raw === undefined || raw === null) return '';\n  var s = String(raw);\n  if (s === '') return '';\n  var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s);\n  var at = m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : new Date(s);\n  if (isNaN(at.getTime())) return '';\n  return at.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });\n}\nif (Inputs.when === undefined) return;\nvar day = humanDay(Inputs.when);\nvar said = day === '' ? String(Inputs.when || '') : day;\nvar where = Inputs.place === undefined || Inputs.place === null ? '' : String(Inputs.place);\nOutputs.label = where === '' ? said : said + ' · ' + where;"
      },
      "x": 410,
      "y": 400,
      "ports": [
        {
          "name": "in-when",
          "displayName": "when",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-place",
          "displayName": "place",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-label",
          "displayName": "label",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
