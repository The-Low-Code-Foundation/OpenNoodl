{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "5e4970aa-ec79-566e-81d0-a0013f158429",
  "version": 1,
  "nodes": [
    {
      "id": "row-2",
      "type": "Group",
      "label": "One meeting",
      "children": [
        "rowTitle-2",
        "rowWhen",
        "rowPlace",
        "detailButton"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column",
        "rowGap": "var(--space-2)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)",
        "marginBottom": "var(--space-4)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "rowTitle-2",
      "type": "Text",
      "label": "Title",
      "parent": "row-2",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "rowWhen",
      "type": "Text",
      "label": "When",
      "parent": "row-2",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "rowPlace",
      "type": "Text",
      "label": "Where",
      "parent": "row-2",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "detailButton",
      "type": "net.noodl.controls.button",
      "label": "Details",
      "parent": "row-2",
      "parameters": {
        "label": "Details",
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--muted-foreground)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "inputs-3",
      "type": "Component Inputs",
      "label": "The meeting",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "when",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "place",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "whenLabel",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "if (Inputs.when === undefined) return;\nconst raw = Inputs.when || '';\nconst at = new Date(raw);\nOutputs.label = isNaN(at.getTime()) ? raw : at.toLocaleDateString();"
      },
      "x": 350,
      "y": 280
    },
    {
      "id": "goDetail-2",
      "type": "RouterNavigate",
      "label": "Open the meeting",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Meeting"
      },
      "x": 350,
      "y": 520
    }
  ],
  "visualRoots": [
    "row-2"
  ]
}
