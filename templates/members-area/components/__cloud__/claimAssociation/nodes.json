    {
      "id": "existing",
      "type": "DbCollection2",
      "label": "Has this members’ area been set up?",
      "parameters": {
        "runOnChange-records": true,
        "runOnChange-search": true,
        "collectionName": "Association",
        "runOnChange-collectionName": false,
