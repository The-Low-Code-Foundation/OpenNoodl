          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-hasAssociation",
          "displayName": "hasAssociation",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-needsSetup",
          "displayName": "needsSetup",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-unanswered",
          "displayName": "unanswered",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
