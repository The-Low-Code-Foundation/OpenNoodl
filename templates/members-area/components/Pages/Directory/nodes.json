      "id": "notModerator-3",
      "type": "JavaScriptFunction",
      "label": "Is this person not a moderator?",
      "parameters": {
        "functionScript": "if (Inputs.isModerator === undefined) return;\nOutputs.no = Inputs.isModerator !== true;"
      },
      "x": 530,
      "y": 760,
      "ports": [
        {
          "name": "in-isModerator",
          "displayName": "isModerator",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-no",
          "displayName": "no",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
