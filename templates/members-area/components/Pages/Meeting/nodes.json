    {
      "id": "hold-2",
      "type": "JavaScriptFunction",
      "label": "Hold the id",
      "parameters": {
        "functionScript": "if (Inputs.meetingId === undefined || Inputs.meetingId === '') return;\nOutputs.meetingId = Inputs.meetingId;\nOutputs.ready();"
      },
      "ports": [
        {
          "name": "out-ready",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 470,
      "y": 40
    },
    {
      "id": "record-2",
      "type": "DbModel2",
      "label": "The meeting",
      "parameters": {
        "collectionName": "Meeting",
        "idSource": "explicit"
      },
      "x": 470,
      "y": 280
    },
    {
      "id": "whenLabel-2",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "function humanDay(raw) {\n  if (raw === undefined || raw === null) return '';\n  var s = String(raw);\n  if (s === '') return '';\n  var m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(s);\n  var at = m ? new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : new Date(s);\n  if (isNaN(at.getTime())) return '';\n  return at.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });\n}\nif (Inputs.when === undefined) return;\nvar day = humanDay(Inputs.when);\nOutputs.label = day === '' ? String(Inputs.when || '') : day;"
      },
      "x": 470,
      "y": 400
    },
    {
      "id": "refusalGate-2",
      "type": "Condition",
      "label": "Show the refusal",
      "parameters": {
        "condition": true,
        "runOnChange-condition": false
      },
      "x": 470,
      "y": 760
    },
