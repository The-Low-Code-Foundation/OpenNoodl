{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "0a61ad36-56ff-50c6-8bf8-facb1107cbba",
  "version": 1,
  "nodes": [
    {
      "id": "page-5",
      "type": "Page",
      "label": "Meetings",
      "children": [
        "ground-5"
      ],
      "parameters": {
        "title": "What’s coming up",
        "urlPath": "meetings"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "ground-5",
      "type": "Group",
      "label": "Page ground",
      "parent": "page-5",
      "children": [
        "heading-4",
        "pendingNotice-2",
        "memberArea-2",
        "backButton-2"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "height": {
          "value": 100,
          "unit": "%"
        },
        "paddingTop": {
          "value": 48,
          "unit": "px"
        },
        "paddingLeft": {
          "value": 24,
          "unit": "px"
        },
        "paddingRight": {
          "value": 24,
          "unit": "px"
        },
        "flexDirection": "column"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "heading-4",
      "type": "Text",
      "label": "Heading",
      "parent": "ground-5",
      "parameters": {
        "text": "What’s coming up",
        "fontWeight": "var(--font-bold)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "pendingNotice-2",
      "type": "Text",
      "label": "Waiting to be approved",
      "parent": "ground-5",
      "parameters": {
        "text": "Your request to join is with the moderators. You will be able to see announcements and meetings once it has been approved.",
        "visible": false
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "memberArea-2",
      "type": "Group",
      "label": "What a member sees",
      "parent": "ground-5",
      "children": [
        "list-2",
        "emptyState-2"
      ],
      "parameters": {
        "flexDirection": "column",
        "visible": false
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "list-2",
      "type": "For Each",
      "label": "One row per meeting",
      "parent": "memberArea-2",
      "parameters": {
        "templateType": "explicit",
        "template": "/Members/MeetingRow"
      },
      "x": 220,
      "y": 640
    },
    {
      "id": "emptyState-2",
      "type": "Text",
      "label": "Nothing in the diary",
      "parent": "memberArea-2",
      "parameters": {
        "text": "No meetings are in the diary yet.",
        "visible": false
      },
      "x": 220,
      "y": 760
    },
    {
      "id": "backButton-2",
      "type": "net.noodl.controls.button",
      "label": "Back",
      "parent": "ground-5",
      "parameters": {
        "label": "Back to the members area"
      },
      "x": 160,
      "y": 880
    },
    {
      "id": "standing-2",
      "type": "/Members/Standing",
      "label": "Who is this?",
      "x": 470,
      "y": 520
    },
    {
      "id": "today",
      "type": "JavaScriptFunction",
      "label": "Today, as an ISO day",
      "parameters": {
        "functionScript": "Outputs.day = new Date().toISOString().slice(0, 10);"
      },
      "x": 470,
      "y": 1000
    },
    {
      "id": "meetings",
      "type": "DbCollection2",
      "label": "Meetings that have not happened yet",
      "parameters": {
        "collectionName": "Meeting",
        "runOnChange-collectionName": false,
        "runOnChange-querySettings": false,
        "visualFilter": {
          "combinator": "and",
          "rules": [
            {
              "property": "when",
              "operator": "greater than or equal to",
              "input": "today"
            }
          ]
        },
        "visualSort": [
          {
            "property": "when",
            "order": "ascending"
          }
        ]
      },
      "x": 470,
      "y": 640
    },
    {
      "id": "emptyGate-2",
      "type": "JavaScriptFunction",
      "label": "Is the diary really empty?",
      "parameters": {
        "functionScript": "Outputs.empty = (Inputs.count || 0) === 0;"
      },
      "x": 470,
      "y": 760
    },
    {
      "id": "toMembers-2",
      "type": "RouterNavigate",
      "label": "Back to the members area",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Members"
      },
      "x": 470,
      "y": 880
    },
    {
      "id": "toLanding-2",
      "type": "RouterNavigate",
      "label": "Out of the members area",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Landing"
      },
      "x": 470,
      "y": 1120
    }
  ],
  "visualRoots": [
    "page-5"
  ]
}
