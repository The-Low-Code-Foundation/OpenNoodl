{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "6d8c5bb3-6024-52d7-8a41-859aae1dcbe4",
  "version": 1,
  "nodes": [
    {
      "id": "page-4",
      "type": "Page",
      "label": "Announcement",
      "children": [
        "ground-4"
      ],
      "parameters": {
        "title": "Announcement",
        "urlPath": "announcements/{announcementId}"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "ground-4",
      "type": "Group",
      "label": "Page ground",
      "parent": "page-4",
      "children": [
        "title",
        "date",
        "body",
        "refusal",
        "backButton"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "maxWidth": {
          "value": 760,
          "unit": "px"
        },
        "flexDirection": "column",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "sizeMode": "explicit",
        "height": {
          "value": 100,
          "unit": "%"
        },
        "alignX": "center",
        "rowGap": "var(--space-5)",
        "paddingTop": "var(--space-12)",
        "paddingBottom": "var(--space-12)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "title",
      "type": "Text",
      "label": "Title",
      "parent": "ground-4",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "date",
      "type": "Text",
      "label": "Posted",
      "parent": "ground-4",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "body",
      "type": "Text",
      "label": "Body",
      "parent": "ground-4",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "refusal",
      "type": "Group",
      "label": "Not available",
      "parent": "ground-4",
      "children": [
        "refusalText"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column",
        "rowGap": "var(--space-2)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "paddingBottom": "var(--space-5)",
        "mounted": false
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "refusalText",
      "type": "Text",
      "label": "Not available — the words",
      "parent": "refusal",
      "parameters": {
        "text": "This announcement is not available to you.",
        "fontSize": "var(--text-sm)",
        "color": "var(--destructive)"
      },
      "x": 220,
      "y": 760
    },
    {
      "id": "backButton",
      "type": "net.noodl.controls.button",
      "label": "Back",
      "parent": "ground-4",
      "parameters": {
        "label": "Back to announcements",
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 880
    },
    {
      "id": "pageInputs",
      "type": "PageInputs",
      "label": "Which announcement",
      "parameters": {
        "pathParams": "announcementId"
      },
      "x": 470,
      "y": 1000
    },
    {
      "id": "hold",
      "type": "JavaScriptFunction",
      "label": "Hold the id",
      "parameters": {
        "functionScript": "if (Inputs.announcementId === undefined || Inputs.announcementId === '') return;\nOutputs.announcementId = Inputs.announcementId;\nOutputs.ready();"
      },
      "ports": [
        {
          "name": "out-ready",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 470,
      "y": 40
    },
    {
      "id": "record",
      "type": "DbModel2",
      "label": "The announcement",
      "parameters": {
        "collectionName": "Announcement",
        "idSource": "explicit"
      },
      "x": 470,
      "y": 280
    },
    {
      "id": "when-2",
      "type": "JavaScriptFunction",
      "label": "The date, as a person writes it",
      "parameters": {
        "functionScript": "if (Inputs.postedAt === undefined) return;\nconst at = new Date(Inputs.postedAt || '');\nOutputs.label = isNaN(at.getTime()) ? '' : at.toLocaleDateString();"
      },
      "x": 470,
      "y": 400
    },
    {
      "id": "refusalGate",
      "type": "Condition",
      "label": "Show the refusal",
      "parameters": {
        "condition": true,
        "runOnChange-condition": false
      },
      "x": 470,
      "y": 640
    },
    {
      "id": "toMembers",
      "type": "RouterNavigate",
      "label": "Back to the members area",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Members"
      },
      "x": 470,
      "y": 880
    }
  ],
  "visualRoots": [
    "page-4"
  ]
}
