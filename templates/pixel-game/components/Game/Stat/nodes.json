      "ports": [
        {
          "name": "label",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "value",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "tone",
          "plug": "output",
          "type": "color"
        }
      ],
