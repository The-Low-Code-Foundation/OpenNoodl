      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)",
        "sizeMode": "contentSize"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "stValue",
      "type": "Text",
      "label": "The number",
      "parent": "stTile",
      "parameters": {
        "text": "",
        "fontSize": {
          "value": 26,
          "unit": "px"
        },
        "fontWeight": "var(--font-semibold)",
        "lineHeight": 1.1,
        "color": "var(--foreground)",
        "fontVariantNumeric": "tabular-nums",
