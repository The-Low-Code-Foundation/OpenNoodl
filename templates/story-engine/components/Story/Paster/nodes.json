{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "7512f8dd-1891-5139-840f-8cb90d2ab58c",
  "version": 1,
  "nodes": [
    {
      "id": "paWrap",
      "type": "Group",
      "label": "Paste a story",
      "children": [
        "paBox",
        "paProblem",
        "paRow"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-4)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "paBox",
      "type": "net.noodl.controls.textinput",
      "label": "The story, as text",
      "parent": "paWrap",
      "parameters": {
        "type": "textArea",
        "sizeMode": "explicit",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "height": {
          "value": 360,
          "unit": "px"
        },
        "useLabel": false,
        "placeholder": "Paste a list of passages here…",
        "cssClassName": "story-paste",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "color": "var(--foreground)",
        "backgroundColor": "var(--surface)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-4)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "paProblem",
      "type": "Text",
      "label": "What is wrong with it",
      "parent": "paWrap",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--destructive)",
        "lineHeight": "var(--leading-snug)",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "paRow",
      "type": "Group",
      "label": "The two buttons",
      "parent": "paWrap",
      "children": [
        "paPlay",
        "paBack"
      ],
      "parameters": {
        "sizeMode": "contentSize",
        "flexDirection": "row",
        "alignItems": "center",
        "flexWrap": "wrap",
        "columnGap": "var(--space-3)",
        "rowGap": "var(--space-3)"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "paPlay",
      "type": "net.noodl.controls.button",
      "label": "Read it",
      "parent": "paRow",
      "parameters": {
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "none",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize",
        "label": "Read this story",
        "cssClassName": "pressable"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "paBack",
      "type": "net.noodl.controls.button",
      "label": "Back to the story",
      "parent": "paRow",
      "parameters": {
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize",
        "label": "Back to reading",
        "cssClassName": "pressable"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "paInputs",
      "type": "Component Inputs",
      "label": "The box",
      "ports": [
        {
          "name": "value",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "problem",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 160
    },
    {
      "id": "paOutputs",
      "type": "Component Outputs",
      "label": "What the reader did",
      "ports": [
        {
          "name": "play",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "back",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "text",
          "plug": "input",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 280
    }
  ],
  "visualRoots": [
    "paWrap"
  ]
}
