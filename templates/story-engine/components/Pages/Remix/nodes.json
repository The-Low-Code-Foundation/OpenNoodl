    {
      "id": "rxHelpBody",
      "type": "Text",
      "label": "The four words",
      "parent": "rxHelp",
      "parameters": {
        "text": "goto — where a choice takes the reader.\ngives — hands them something, and it shows up in What you carry.\nrequires — the choice is invisible until they are carrying that thing. Not greyed out: absent.\nno choices at all — that passage is an ending.",
        "width": {
          "value": 100,
          "unit": "%"
