        "sizeMode": "contentHeight",
        "fontSize": "var(--text-base)",
        "color": "var(--foreground)",
        "lineHeight": 1.8
      },
      "x": 280,
      "y": 1240
    },
    {
      "id": "rxHelpExample",
      "type": "Text",
      "label": "A whole story, three passages long",
      "parent": "rxHelp",
      "parameters": {
        "text": "[\n  {\n    \"id\": \"hall\",\n    \"title\": \"The hallway\",\n    \"text\": \"Two doors. One of them is warm to the touch.\",\n    \"choices\": [\n      { \"label\": \"Open the warm door\", \"goto\": \"kitchen\", \"gives\": \"a brass key\" },\n      { \"label\": \"Unlock the far door\", \"goto\": \"out\", \"requires\": \"a brass key\" }\n    ]\n  },\n  { \"id\": \"kitchen\", \"title\": \"The kitchen\", \"text\": \"A key on the hook.\", \"choices\": [\n      { \"label\": \"Go back\", \"goto\": \"hall\" } ] },\n  { \"id\": \"out\", \"title\": \"Outside\", \"text\": \"You are out. No choices: that is an ending.\" }\n]",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
