    {
      "id": "rdScreen",
      "type": "JavaScriptFunction",
      "label": "What you can see from here",
      "parameters": {
        "functionScript": "const choices = Inputs.choices || [];\nconst carrying = Inputs.carrying || [];\nconst at = String(Inputs.at || '');\nconst isEnding = Inputs.isEnding === true;\n\nconst have = {};\nfor (let i = 0; i < carrying.length; i++) {\n  const entry = carrying[i];\n  const name = typeof entry === 'string' ? entry : String((entry || {}).thing || '');\n  if (name !== '') have[name] = true;\n}\n\nconst rows = [];\nfor (let i = 0; i < choices.length; i++) {\n  const c = choices[i] || {};\n  const needs = String(c.requires || '');\n  // Absent, not greyed out. See the note above — this is the story, not the CSS.\n  if (needs !== '' && have[needs] !== true) continue;\n  rows.push({\n    id: at + '#' + i,\n    label: String(c.label || ''),\n    goto: String(c.goto || ''),\n    gives: String(c.gives || '')\n  });\n}\n\nOutputs.rows = rows;\nOutputs.carryCount = Object.keys(have).length;\n// 🔴 A passage that is not an ending and has nothing the reader can take. Every\n// choice it owns needs something they are not carrying, so the story stops here\n// and nothing in the data says it meant to.\nOutputs.stuck = !isEnding && rows.length === 0;"
      },
      "x": 530,
      "y": 1000,
      "ports": [
        {
          "name": "in-choices",
          "displayName": "choices",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-carrying",
          "displayName": "carrying",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-at",
          "displayName": "at",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-isEnding",
          "displayName": "isEnding",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-rows",
          "displayName": "rows",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-carryCount",
          "displayName": "carryCount",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-stuck",
