        }
      ]
    },
    {
      "id": "rdCarry",
      "type": "JavaScriptFunction",
      "label": "Take what that choice gives you",
      "parameters": {
        "functionScript": "const carrying = Inputs.carrying || [];\nconst gift = String(Inputs.gift || '');\n\nconst out = [];\nconst seen = {};\nfor (let i = 0; i < carrying.length; i++) {\n  const entry = carrying[i];\n  const name = typeof entry === 'string' ? entry : String((entry || {}).thing || '');\n  if (name === '' || seen[name] === true) continue;\n  seen[name] = true;\n  out.push({ id: name, thing: name });\n}\n\nif (gift === '' || seen[gift] === true) {\n  Outputs.added = false;\n} else {\n  out.push({ id: gift, thing: gift });\n  Outputs.added = true;\n}\n\n// A fresh array every run: Outputs publishes only on change, and a mutated array\n// is the same object, so a reused one would never reach the graph.\nOutputs.carrying = out;",
        "runOnChange-in-carrying": false,
        "runOnChange-in-gift": false
      },
      "x": 530,
      "y": 1120,
      "ports": [
        {
          "name": "in-carrying",
          "displayName": "carrying",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-gift",
          "displayName": "gift",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-added",
          "displayName": "added",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-carrying",
