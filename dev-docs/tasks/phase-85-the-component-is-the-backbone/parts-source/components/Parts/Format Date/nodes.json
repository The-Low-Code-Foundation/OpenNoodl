{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "f825325f-c851-4a0c-a197-b5293ac3acee",
  "version": 1,
  "nodes": [
    {
      "id": "fdIn",
      "type": "Component Inputs",
      "label": "What to format",
      "x": 60,
      "y": 60,
      "ports": [
        {
          "name": "date",
          "plug": "output",
          "type": "date"
        },
        {
          "name": "style",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "format",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "locale",
          "plug": "output",
          "type": "string"
        }
      ]
    },
    {
      "id": "fdPick",
      "type": "JavaScriptFunction",
      "label": "Style to format string",
      "x": 420,
      "y": 60,
      "parameters": {
        "functionScript": "// One named style instead of twenty-one tokens to remember.\n// Every preset below is written in Date To String's own token vocabulary,\n// so Format overrides it with anything that node can read.\nvar PRESETS = {\n  short: '{date}/{month}/{yearShort}',\n  date: '{monthName} {ordinal}, {year}',\n  long: '{dayName} {ordinal} {monthName} {year}',\n  time: '{h12}:{minutes} {ampm}',\n  datetime: '{dayShort} {ordinal} {monthShort} {year}, {h12}:{minutes} {ampm}',\n  iso: '{year}-{month}-{date}'\n};\nvar custom = String(Inputs.format == null ? '' : Inputs.format).trim();\nif (custom) { Outputs.format = custom; return; }\nvar key = String(Inputs.style == null ? '' : Inputs.style).trim().toLowerCase();\nOutputs.format = PRESETS[key] || PRESETS.date;"
      },
      "ports": [
        {
          "name": "in-style",
          "plug": "input",
          "type": "*",
          "displayName": "style",
          "group": "Inputs"
        },
        {
          "name": "in-format",
          "plug": "input",
          "type": "*",
          "displayName": "format",
          "group": "Inputs"
        },
        {
          "name": "out-format",
          "plug": "output",
          "type": "string",
          "displayName": "format",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "fdFormat",
      "type": "Date To String",
      "label": "Render it",
      "x": 780,
      "y": 60,
      "parameters": {
        "formatString": "{monthName} {ordinal}, {year}"
      }
    },
    {
      "id": "fdOut",
      "type": "Component Outputs",
      "label": "The string",
      "x": 1140,
      "y": 60,
      "ports": [
        {
          "name": "text",
          "plug": "input",
          "type": "string"
        }
      ]
    }
  ]
}