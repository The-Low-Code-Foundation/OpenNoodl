        "type": "json",
        "json": "[{\"id\":\"q1\",\"quote\":\"I stopped opening a browser to check what the page looked like. That is the whole review.\",\"name\":\"Priya Raman\",\"role\":\"Design lead, Kiln & Co.\",\"portrait\":\"noodl_modules/starter-imagery/avatar-3.webp\"},{\"id\":\"q2\",\"quote\":\"The first project already had a typeface, an icon set and six pictures in it. I built the page, not the scaffolding.\",\"name\":\"Tom Aldiss\",\"role\":\"Founder, two-person studio\",\"portrait\":\"noodl_modules/starter-imagery/avatar-1.webp\"},{\"id\":\"q3\",\"quote\":\"We ran the whole workshop on a train with no signal and nothing degraded.\",\"name\":\"Marguerite Osei\",\"role\":\"Training, NHS trust\",\"portrait\":\"noodl_modules/starter-imagery/avatar-2.webp\"}]"
