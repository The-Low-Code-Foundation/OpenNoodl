      "parent": "shell_a"
    },
    {
      "id": "a_heading",
      "type": "Text",
      "label": "Heading",
      "parameters": {
        "text": "The nav stays; this does not",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)"
      },
      "parent": "shell_a"
    },
    {
      "id": "a_body",
      "type": "Text",
      "label": "Body",
      "parameters": {
        "text": "The band above is a plain Group with Position set to Sticky and Align Y set to Top. There is no Top port on this canvas — Align Y is what writes the inset, and setting it to Center pins the band half a screen down instead of at the edge. Everything on this page passes underneath the band, so the band has to be opaque and carry a zIndex; without one its text and this text draw on top of each other.",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
        "maxWidth": {
          "value": 620,
          "unit": "px"
        }
      },
      "parent": "shell_a"
    },
    {
      "id": "band_b",
      "type": "Group",
      "label": "Band B",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "center",
        "backgroundColor": "var(--surface)",
        "borderTopStyle": "solid",
        "borderTopWidth": "var(--border-1)",
        "borderTopColor": "var(--border)",
        "paddingTop": "var(--space-24)",
        "paddingBottom": "var(--space-24)"
