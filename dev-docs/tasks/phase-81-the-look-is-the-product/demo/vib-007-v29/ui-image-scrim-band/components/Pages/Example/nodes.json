        "color": "var(--primary-foreground)",
        "maxWidth": {
          "value": 760,
          "unit": "px"
        }
      },
      "parent": "shell"
    },
    {
      "id": "sub",
      "type": "Text",
      "label": "Sub-line",
      "parameters": {
        "text": "Six weeks of glazing tests, and one kiln that finally behaved.",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--primary-foreground)",
        "maxWidth": {
          "value": 560,
          "unit": "px"
        }
      },
      "parent": "shell"
