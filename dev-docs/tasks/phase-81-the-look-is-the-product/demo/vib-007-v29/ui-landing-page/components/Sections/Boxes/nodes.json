{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e34ef86e-df1c-5c9b-8131-1f8bb899c900",
  "version": 1,
  "nodes": [
    {
      "id": "boxes_band",
      "type": "Group",
      "label": "The boxes",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "column",
        "alignItems": "center",
        "paddingTop": "var(--space-20)",
        "paddingBottom": "var(--space-20)",
        "backgroundColor": "var(--surface)",
        "borderTopStyle": "solid",
        "borderTopWidth": "var(--border-1)",
        "borderTopColor": "var(--border)",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "borderBottomColor": "var(--border)"
      },
      "children": [
        "boxes_shell"
      ]
    },
    {
      "id": "boxes_shell",
      "type": "Group",
      "label": "Shell",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "maxWidth": {
          "value": 1200,
          "unit": "px"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      },
      "parent": "boxes_band",
      "children": [
        "boxes_head",
        "boxes_cols"
      ]
    },
    {
      "id": "boxes_head",
      "type": "Group",
      "label": "Section head",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-3)",
        "paddingBottom": "var(--space-10)"
      },
      "parent": "boxes_shell",
      "children": [
        "boxes_eyebrow",
        "boxes_title",
        "boxes_lead"
      ]
    },
    {
      "id": "boxes_eyebrow",
      "type": "Text",
      "label": "boxes_eyebrow",
      "parameters": {
        "fontSize": "var(--text-xs)",
        "fontWeight": "var(--font-semibold)",
        "letterSpacing": "var(--tracking-widest)",
        "textTransform": "uppercase",
        "color": "var(--primary)",
        "text": "The boxes"
      },
      "parent": "boxes_head"
    },
    {
      "id": "boxes_title",
      "type": "Text",
      "label": "boxes_title",
      "parameters": {
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)",
        "text": "Three sizes, and a table on Saturdays."
      },
      "parent": "boxes_head"
    },
    {
      "id": "boxes_lead",
      "type": "Text",
      "label": "boxes_lead",
      "parameters": {
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
        "maxWidth": {
          "value": 560,
          "unit": "px"
        },
        "text": "Cancel any week before Wednesday midnight. No contract, no minimum, no app."
      },
      "parent": "boxes_head"
    },
    {
      "id": "boxes_cols",
      "type": "net.noodl.visual.columns",
      "label": "Three up",
      "parameters": {
        "layoutString": "1 1 1",
        "marginX": {
          "value": 24,
          "unit": "px"
        },
        "mediumBreakpoint": {
          "value": 900,
          "unit": "px"
        },
        "mediumLayout": "1",
        "smallBreakpoint": {
          "value": 640,
          "unit": "px"
        },
        "smallLayout": "1"
      },
      "parent": "boxes_shell",
      "children": [
        "boxes_c1",
        "boxes_c2",
        "boxes_c3"
      ]
    },
    {
      "id": "boxes_c1",
      "type": "/Components/BoxCard",
      "label": "Small box",
      "parameters": {
        "image": "noodl_modules/starter-imagery/food-carrots.webp",
        "alt": "Carrots in a wooden crate",
        "title": "The small box",
        "price": "£14 a week",
        "body": "Six or seven lines. Enough for two people who cook most nights."
      },
      "parent": "boxes_cols"
    },
    {
      "id": "boxes_c2",
      "type": "/Components/BoxCard",
      "label": "Full box",
      "parameters": {
        "image": "noodl_modules/starter-imagery/food-board.webp",
        "alt": "A red onion and peppercorns on a wooden board",
        "title": "The full box",
        "price": "£22 a week",
        "body": "Ten to twelve lines, including the awkward ones. Feeds four, or two who batch-cook."
      },
      "parent": "boxes_cols"
    },
    {
      "id": "boxes_c3",
      "type": "/Components/BoxCard",
      "label": "Saturday stall",
      "parameters": {
        "image": "noodl_modules/starter-imagery/food-grocer.webp",
        "alt": "A greengrocer stall with a customer choosing vegetables",
        "title": "The Saturday stall",
        "price": "Eight until it goes",
        "body": "Whatever did not fit in a box, on the table at Ashcombe Cross."
      },
      "parent": "boxes_cols"
    }
  ],
  "visualRoots": [
    "boxes_band"
  ]
}
