          "functionScript": "const items = Inputs.items || [];\nconst rows = items.map(function(it){\n  var d = '';\n  if (it.savedAt) { try { d = new Date(it.savedAt).toLocaleDateString(); } catch(e) { d = ''; } }\n  return (it.title || 'Untitled') + '  \\u2014  ' + d;\n});\nOutputs.text = rows.length ? rows.join('\\n') : 'No saved articles yet.';"
