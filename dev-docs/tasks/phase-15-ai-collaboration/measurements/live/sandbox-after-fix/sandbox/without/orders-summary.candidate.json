      {
        "id": "compute",
        "type": "JavaScriptFunction",
        "label": "Compute summary + sorted rows",
        "x": 250,
        "y": -200,
        "parameters": {
          "functionScript": "const items = Inputs.items || [];\nconst sorted = [...items].sort((a,b) => new Date(b.datePlaced) - new Date(a.datePlaced));\nconst total = items.reduce((s,o)=>s+(Number(o.total)||0),0);\nOutputs.summary = items.length + ' orders totalling $' + total.toFixed(2);\nconst header = 'Order #\\tCustomer\\tTotal\\tStatus\\tDate placed';\nconst lines = sorted.map(o => (o.orderNumber||'') + '\\t' + (o.customerName||'') + '\\t$' + (Number(o.total)||0).toFixed(2) + '\\t' + (o.status||'') + '\\t' + (o.datePlaced||''));\nOutputs.rows = [header].concat(lines).join('\\n');"
        }
      },
      {
        "id": "summaryText",
        "type": "Text",
        "label": "Order count + total",
        "x": 500,
