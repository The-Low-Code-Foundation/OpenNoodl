        "type": "net.noodl.controls.button",
        "label": "Save toggle button",
        "x": 220,
        "y": 50,
        "parent": "root",
        "parameters": {
          "label": "Save",
          "variant": "outline",
          "size": "md",
          "iconIconSource": "bookmark",
