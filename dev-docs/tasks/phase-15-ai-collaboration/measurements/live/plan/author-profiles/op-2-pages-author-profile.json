      {
        "id": "extractAuthor",
        "type": "JavaScriptFunction",
        "label": "Extract author fields",
        "x": 0,
        "y": 150,
        "parameters": {
          "functionScript": "if(Inputs.author){\n  Outputs.name = Inputs.author.name;\n  Outputs.bio = Inputs.author.bio;\n  Outputs.photo = Inputs.author.photo;\n  Outputs.articles = Inputs.author.articles;\n}"
        }
      },
      {
        "id": "buildItems",
        "type": "JavaScriptFunction",
        "label": "Build repeater items from articles",
        "x": 300,
        "y": 150,
        "parameters": {
          "functionScript": "if(Inputs.articles){\n  var items = [];\n  for(var i=0;i<Inputs.articles.length;i++){\n    var a = Inputs.articles[i];\n    items.push({id:a.slug, Label:a.title, \"Icon Src Set\":\"\"});\n  }\n  Outputs.items = items;\n}"
        }
      },
