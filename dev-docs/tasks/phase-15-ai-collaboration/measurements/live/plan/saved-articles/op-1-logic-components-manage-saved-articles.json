    "name": "Manage Saved Articles",
    "path": "/Logic Components/Manage Saved Articles",
    "type": "visual",
    "created": "2026-07-27T20:34:56.258Z",
    "modified": "2026-07-27T20:34:56.258Z",
    "modifiedBy": "ai-authoring",
    "description": "Logic component managing a user's saved articles: toggles save/unsave records in a SavedArticle cloud class for the current user based on the 'action' input, and always exposes the current isSaved status for the given articleId plus the full live list of the user's saved articles."
  },
  "nodes": {
