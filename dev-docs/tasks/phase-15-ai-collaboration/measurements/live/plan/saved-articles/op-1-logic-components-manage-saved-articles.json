      {
        "id": "query",
        "type": "DbCollection2",
        "label": "Query Saved Articles",
        "x": 150,
        "y": 600,
        "parameters": {
          "collectionName": "SavedArticle"
        }
      },
      {
        "id": "savedForUser",
        "type": "Expression",
        "label": "Filter items for current user",
        "x": 400,
        "y": 600,
        "parameters": {
          "expression": "items.filter(r => r.userId === userId)"
        }
      },
      {
        "id": "isSavedExpr",
        "type": "Expression",
        "label": "Compute isSaved",
        "x": 650,
        "y": 700,
        "parameters": {
          "expression": "savedForUser.some(r => r.articleId === articleId)"
        }
      },
      {
        "id": "existingRecord",
        "type": "Expression",
        "label": "Find existing record",
        "x": 650,
        "y": 850,
        "parameters": {
          "expression": "savedForUser.find(r => r.articleId === articleId)"
        }
      },
      {
        "id": "existingId",
        "type": "Expression",
        "label": "Existing record id",
        "x": 900,
        "y": 850,
        "parameters": {
          "expression": "existingRecord ? existingRecord.id : ''"
        }
      },
      {
        "id": "eqSave",
        "type": "Expression",
        "label": "action == save",
        "x": 150,
        "y": 50,
        "parameters": {
          "expression": "action === 'save'"
        }
      },
      {
        "id": "eqUnsave",
        "type": "Expression",
        "label": "action == unsave",
        "x": 150,
        "y": 150,
        "parameters": {
          "expression": "action === 'unsave'"
        }
      },
      {
        "id": "condSave",
        "type": "Condition",
        "label": "On Save",
        "x": 400,
        "y": 50
      },
      {
        "id": "condUnsave",
        "type": "Condition",
        "label": "On Unsave",
        "x": 400,
        "y": 150
      },
      {
        "id": "createRecord",
        "type": "NewDbModelProperties",
        "label": "Create Saved Record",
        "x": 650,
        "y": 50,
        "parameters": {
          "collectionName": "SavedArticle"
        }
      },
      {
        "id": "deleteRecord",
        "type": "DeleteDbModelProperties",
        "label": "Delete Saved Record",
        "x": 900,
        "y": 150
      }
    ]
  },
