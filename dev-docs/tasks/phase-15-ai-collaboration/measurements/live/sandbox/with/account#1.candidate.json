      {
        "id": "formatList",
        "type": "Javascript2",
        "label": "Format saved articles as lines",
        "x": 300,
        "y": 800,
        "parameters": {
          "scriptInputs": [
            {
              "name": "items",
              "type": "array"
            }
          ],
          "scriptOutputs": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "code": "define({\n  inputs: { items: 'array' },\n  outputs: { text: 'string' },\n  run: function(inputs, outputs) {\n    var items = inputs.items || [];\n    var lines = items.map(function(i){\n      var d = i.savedAt ? new Date(i.savedAt).toLocaleDateString() : '';\n      return (i.title || '') + '  \\u2014  ' + d;\n    });\n    outputs.text = lines.join('\\n');\n  }\n});"
        }
      }
