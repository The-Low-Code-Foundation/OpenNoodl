      {
        "id": "listjs",
        "type": "Javascript2",
        "label": "Filter to this user's saved articles and format as text",
        "x": 260,
        "y": 320,
        "parameters": {
          "code": "define({\n  inputs: { items: 'array', userId: 'string' },\n  outputs: { listText: 'string' },\n  run: function(inputs, outputs) {\n    var items = inputs.items || [];\n    var uid = inputs.userId;\n    var filtered = items.filter(function(a){ return a.userId === uid; });\n    filtered.sort(function(a,b){ return new Date(b.savedAt) - new Date(a.savedAt); });\n    var lines = filtered.map(function(a){\n      var d = new Date(a.savedAt);\n      var dateStr = d.toLocaleDateString();\n      return a.title + '  —  saved ' + dateStr;\n    });\n    outputs.listText = lines.length ? lines.join('\\n\\n') : 'No saved articles yet.';\n  }\n});"
        }
      },
