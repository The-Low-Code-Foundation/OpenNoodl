          "functionScript": "if (!Inputs.items || !Inputs.items.length) {\n  Outputs.list = 'No saved articles yet.';\n  return;\n}\nOutputs.list = Inputs.items.map(function(it){\n  var d = new Date(it.savedAt);\n  var ds = isNaN(d.getTime()) ? '' : d.toLocaleDateString();\n  return (it.title || 'Untitled') + '  —  ' + ds;\n}).join('\\n');"
