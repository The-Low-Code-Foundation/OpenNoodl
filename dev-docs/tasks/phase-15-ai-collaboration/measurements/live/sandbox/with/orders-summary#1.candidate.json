      },
      {
        "id": "summaryFn",
        "type": "JavaScriptFunction",
        "label": "Compute order count & total",
        "x": -100,
        "y": -150,
        "parameters": {
          "functionScript": "var items = Inputs.items || [];\nvar count = items.length;\nvar total = 0;\nfor (var i = 0; i < items.length; i++) {\n  total += Number(items[i].total) || 0;\n}\nOutputs.summaryText = count + (count === 1 ? ' order' : ' orders') + ', totaling $' + total.toFixed(2);"
        }
      },
      {
        "id": "rowsFn",
        "type": "JavaScriptFunction",
        "label": "Build sorted order rows text",
        "x": -100,
        "y": 150,
        "parameters": {
          "functionScript": "var items = (Inputs.items || []).slice();\nitems.sort(function(a, b) {\n  return new Date(b.placedAt) - new Date(a.placedAt);\n});\nvar lines = items.map(function(o) {\n  var date = o.placedAt ? new Date(o.placedAt).toLocaleDateString() : '';\n  return (o.orderNumber || '') + '   ' + (o.customerName || '') + '   $' + (Number(o.total) || 0).toFixed(2) + '   ' + (o.status || '') + '   ' + date;\n});\nOutputs.rowsText = lines.join('\\n');"
        }
      },
      {
        "id": "summaryText",
        "type": "Text",
        "label": "Order count & total line",
        "x": 300,
        "y": -150,
        "parent": "root",
        "parameters": {
          "variant": "lead",
          "text": "0 orders, totaling $0.00"
        }
      },
