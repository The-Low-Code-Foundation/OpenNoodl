          "heightUnit": "%",
          "height": 100
        }
      },
      {
        "id": "ordersQuery",
        "type": "DbCollection2",
        "label": "Query all Orders",
        "x": 0,
        "y": 300,
        "parameters": {
          "collectionName": "Orders"
        }
      },
      {
        "id": "sortExpr",
        "type": "Expression",
        "label": "Sort orders by date, newest first",
        "x": 300,
        "y": 300,
        "parameters": {
          "expression": "[...items].sort((a,b)=> new Date(b.datePlaced) - new Date(a.datePlaced))"
        }
      },
      {
        "id": "summaryExpr",
        "type": "Expression",
        "label": "Summary line (count + total)",
        "x": 600,
        "y": 200,
        "parameters": {
          "expression": "items.length + ' orders · $' + items.reduce((s,o)=>s+o.total,0).toFixed(2) + ' total'"
        }
      },
      {
        "id": "rowsExpr",
        "type": "Expression",
        "label": "Format order rows as text",
        "x": 600,
        "y": 400,
        "parameters": {
          "expression": "items.map(o => o.orderNumber + '   |   ' + o.customerName + '   |   $' + o.total.toFixed(2) + '   |   ' + o.status + '   |   ' + new Date(o.datePlaced).toLocaleDateString()).join('\\n')"
        }
      },
      {
        "id": "summaryText",
        "type": "Text",
        "label": "Summary text",
        "x": 900,
        "y": 0,
        "parent": "root",
        "parameters": {
          "variant": "heading-4",
          "text": "Loading orders…"
        }
      },
