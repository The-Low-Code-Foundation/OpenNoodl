      {
        "id": "calc",
        "type": "JavaScriptFunction",
        "label": "Sort orders, compute summary and row text",
        "x": -150,
        "y": 0,
        "parameters": {
          "functionScript": "var items = Inputs.items || [];\nvar sorted = items.slice().sort(function(a,b){ return new Date(b.datePlaced) - new Date(a.datePlaced); });\nvar total = sorted.reduce(function(s,o){ return s + (Number(o.total)||0); }, 0);\nOutputs.summary = sorted.length + ' orders · $' + total.toFixed(2) + ' total';\nvar rows = sorted.map(function(o){\n  var d = o.datePlaced ? new Date(o.datePlaced).toLocaleDateString() : '';\n  return (o.orderNumber||'') + '   ' + (o.customerName||'') + '   $' + (Number(o.total)||0).toFixed(2) + '   ' + (o.status||'') + '   ' + d;\n});\nOutputs.rowsText = rows.join('\\n');"
        }
      },
      {
        "id": "summaryText",
        "type": "Text",
        "label": "Order count and total",
        "x": 150,
        "y": 0,
        "parent": "root",
        "parameters": {
