      {
        "id": "formatList",
        "type": "JavaScriptFunction",
        "label": "Format saved article list as title — date lines",
        "x": 1200,
        "y": 150,
        "parameters": {
          "functionScript": "const items = Inputs.items || [];\nif (!items.length) {\n  Outputs.listText = 'No saved articles yet.';\n  return;\n}\nOutputs.listText = items.map(i => {\n  const d = i.savedAt ? new Date(i.savedAt) : null;\n  const dateStr = d ? d.toLocaleDateString() : '';\n  return (i.title || 'Untitled') + '  —  ' + dateStr;\n}).join('\\n');"
        }
      },
