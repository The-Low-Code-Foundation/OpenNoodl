{
  "id": "cloud-record-crud",
  "title": "Records on a REST backend: query, create, update, delete",
  "description": "One Record family serves every backend. Query Records fetches on demand into `items` (re-trigger `storageFetch` to refresh — a query with realtime off does not re-query itself), Create/Update/Delete Record each act on a `store` signal and answer `done` (or `failure`) followed by `completed`, and Update and Delete take the record's `modelId`. After any write the query's `storageFetch` is re-triggered to refresh the list. No node here names a backend, so all five resolve the project's selected one; set the `Backend` input to point a single node somewhere else.",
  "demonstrates": [
    "DbCollection2",
    "NewDbModelProperties",
    "SetDbModelProperties",
    "DeleteDbModelProperties"
  ],
  "components": [
    {
      "name": "/Notes Admin",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Admin",
          "parameters": {
            "flexDirection": "column"
          },
          "children": [
            "add_btn",
            "rename_btn",
            "delete_btn",
            "notes_repeater"
          ]
        },
        {
          "id": "add_btn",
          "type": "net.noodl.controls.button",
          "label": "Add",
          "parent": "root",
          "parameters": {
            "label": "New note"
          }
        },
        {
          "id": "rename_btn",
          "type": "net.noodl.controls.button",
          "label": "Rename",
          "parent": "root",
          "parameters": {
            "label": "Rename selected"
          }
        },
        {
          "id": "delete_btn",
          "type": "net.noodl.controls.button",
          "label": "Delete",
          "parent": "root",
          "parameters": {
            "label": "Delete selected"
          }
        },
        {
          "id": "notes_repeater",
          "type": "For Each",
          "label": "Notes",
          "parent": "root",
          "parameters": {
            "template": "/Note Row"
          }
        },
        {
          "id": "notes_query",
          "type": "DbCollection2",
          "label": "Fetch notes",
          "parameters": {
            "collectionName": "Note"
          }
        },
        {
          "id": "create_note",
          "type": "NewDbModelProperties",
          "label": "Create note",
          "parameters": {
            "collectionName": "Note"
          }
        },
        {
          "id": "update_note",
          "type": "SetDbModelProperties",
          "label": "Update note",
          "parameters": {
            "collectionName": "Note",
            "idSource": "value"
          }
        },
        {
          "id": "delete_note",
          "type": "DeleteDbModelProperties",
          "label": "Delete note",
          "parameters": {
            "collectionName": "Note",
            "idSource": "value"
          }
        }
      ],
      "connections": [
        {
          "fromId": "notes_query",
          "fromProperty": "items",
          "toId": "notes_repeater",
          "toProperty": "items"
        },
        {
          "fromId": "add_btn",
          "fromProperty": "onClick",
          "toId": "create_note",
          "toProperty": "store"
        },
        {
          "fromId": "rename_btn",
          "fromProperty": "onClick",
          "toId": "update_note",
          "toProperty": "store"
        },
        {
          "fromId": "delete_btn",
          "fromProperty": "onClick",
          "toId": "delete_note",
          "toProperty": "store"
        },
        {
          "fromId": "create_note",
          "fromProperty": "done",
          "toId": "notes_query",
          "toProperty": "storageFetch"
        },
        {
          "fromId": "update_note",
          "fromProperty": "done",
          "toId": "notes_query",
          "toProperty": "storageFetch"
        },
        {
          "fromId": "delete_note",
          "fromProperty": "done",
          "toId": "notes_query",
          "toProperty": "storageFetch"
        }
      ]
    },
    {
      "name": "/Note Row",
      "nodes": [
        {
          "id": "row",
          "type": "Group",
          "label": "Row",
          "parameters": {
            "flexDirection": "row"
          },
          "children": [
            "title_text"
          ]
        },
        {
          "id": "title_text",
          "type": "Text",
          "label": "Title",
          "parent": "row"
        },
        {
          "id": "row_inputs",
          "type": "Component Inputs",
          "label": "Record in",
          "ports": [{ "name": "title", "plug": "output", "type": "*" }]
        }
      ],
      "connections": [
        {
          "fromId": "row_inputs",
          "fromProperty": "title",
          "toId": "title_text",
          "toProperty": "text"
        }
      ]
    }
  ]
}
