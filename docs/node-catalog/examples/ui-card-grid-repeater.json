              "plug": "output",
              "type": "*"
            }
          ]
        }
      ],
      "connections": [
        {
          "fromId": "card_inputs",
          "fromProperty": "name",
          "toId": "title",
          "toProperty": "text"
        },
        {
          "fromId": "card_inputs",
          "fromProperty": "tagline",
          "toId": "sub",
          "toProperty": "text"
        },
        {
          "fromId": "card_inputs",
          "fromProperty": "image",
          "toId": "photo",
          "toProperty": "src"
        },
        {
          "fromId": "card_inputs",
          "fromProperty": "imageAlt",
          "toId": "photo",
          "toProperty": "alt"
        },
        {
          "fromId": "card_inputs",
          "fromProperty": "badge",
          "toId": "badge_text",
          "toProperty": "text"
        },
        {
          "fromId": "card_inputs",
          "fromProperty": "badge",
          "toId": "badge",
          "toProperty": "visible"
        }
      ]
    }
  ]
}
