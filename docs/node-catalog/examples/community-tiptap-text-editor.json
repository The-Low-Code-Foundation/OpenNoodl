     }
    },
    {
     "id": "retrieve-local-storage-data",
     "type": "JavaScriptFunction",
     "label": "Retrieve Local Storage Data",
     "parameters": {
      "functionScript": "\nconst key = Inputs.Key || 'editorContent';\nif (!key) return;\n\ntry {\n  const content = localStorage.getItem(key);\n  Outputs.EditorContent = content;\n  Outputs.Success();\n} catch (error) {\n  Outputs.error = error;\n  Outputs.Failure();\n}\n"
     }
    },
    {
     "id": "save-html-to-local-storage",
     "type": "JavaScriptFunction",
     "label": "Save HTML to Local Storage",
     "parameters": {
      "functionScript": "\nconst html = Inputs.html || '';\nif (!html) return;\n\ntry {\n  // const stringifiedHtml = JSON.stringify(html);\n  localStorage.setItem('editorContent', html);\n  console.log(\"editorContent\", localStorage.getItem('editorContent'))\n  Outputs.Success();\n} catch (error) {\n  Outputs.error = error;\n  Outputs.Failure();\n}\n"
     }
    },
