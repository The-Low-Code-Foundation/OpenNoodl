    {
     "id": "create-text-editor",
     "type": "JavaScriptFunction",
     "label": "Create Text Editor",
     "parameters": {
      "functionScript": "\nconst editorContent = Inputs.EditorContent || '<p>nothing</p>';\nconst editorOptions = Noodl.Objects[Inputs.EditorOptions] || {};\nconst editorDiv = Inputs.EditorDiv.getDOMElement()\n\ntry {\n  const { Editor } = await import('https://esm.sh/@tiptap/core');\n  const { StarterKit } = await import('https://esm.sh/@tiptap/starter-kit');\n\n  const options = {\n    content: editorContent,\n    element: editorDiv,\n    autofocus: editorOptions.autofocus || true,\n    editable: editorOptions.editable || true,\n    injectCSS: editorOptions.injectCSS || false,\n    onUpdate({ editor }) {\n      Outputs.ContentUpdated()\n    },\n    onBeforeCreate({ editor }) {\n    // Before the view is created.\n    },\n    onCreate({ editor }) {\n      // The editor is ready.\n      Outputs.EditorIsReady()\n    },\n    onSelectionUpdate({ editor }) {\n      // The selection has changed.\n      editor = editor\n      Outputs.isBold = editor.isActive('bold').toString()\n      Outputs.isItalic = editor.isActive('italic').toString()\n    },\n    onTransaction({ editor, transaction }) {\n      // The editor state has changed.\n      editor = editor\n      Outputs.isBold = editor.isActive('bold').toString()\n      Outputs.isItalic = editor.isActive('italic').toString()\n    },\n    onFocus({ editor, event }) {\n      // The editor is focused.\n    },\n    onBlur({ editor, event }) {\n      // The editor isn\u2019t focused anymore.\n    },\n    onDestroy() {\n      // The editor is being destroyed.\n    },\n  }\n\n  let extensions = [StarterKit.configure({\n    heading: {\n      levels: editorOptions.headings || [],\n    }\n  })];\n\n  options.extensions = extensions;\n\n  const editor = new Editor( options );\n\n  Noodl.Objects.editor = editor\n  // Outputs.EditorObject = editor; // Added output for the editor object\n  Outputs.EditorObject =   Outputs.EditorObject = editor; // Added output for the editor object; // Added output for the editor object\n\n  window.editor = editor //for troubleshooting\n  Outputs.Success();\n} catch (error) {\n  Outputs.error = error;\n  Outputs.Failure();\n}",
      "scriptOutputs": [
       {
        "id": "4rc5",
        "label": "isBold"
       },
       {
        "id": "7ztx",
        "label": "isItalic"
       }
      ]
     }
    },
