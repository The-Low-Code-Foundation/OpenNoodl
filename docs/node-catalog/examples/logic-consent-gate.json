{
  "id": "logic-consent-gate",
  "title": "Gate a button on all required checks, reveal a note on any optional one",
  "description": "And and Or as pure boolean-value combiners over numbered inputs. Two required checkboxes feed an And node's \"input 0\" and \"input 1\"; its `result` drives the submit button's `enabled` as a level, so the button enables the instant both are ticked and disables again if either is cleared. Two optional email checkboxes feed an Or the same way; its `result` shows an explanatory note while at least one is ticked. No signals are involved — everything here is level logic.",
  "demonstrates": ["And", "Or"],
  "components": [
    {
      "name": "/Consent Form",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Form layout",
          "parameters": { "flexDirection": "column", "paddingLeft": 16, "paddingTop": 16 },
          "children": ["terms_check", "age_check", "news_check", "offers_check", "email_note", "submit_button"]
        },
        {
          "id": "terms_check",
          "type": "net.noodl.controls.checkbox",
          "label": "Terms consent",
          "parent": "root",
          "parameters": { "useLabel": true, "label": "I accept the terms of service" }
        },
        {
          "id": "age_check",
          "type": "net.noodl.controls.checkbox",
          "label": "Age confirmation",
          "parent": "root",
          "parameters": { "useLabel": true, "label": "I am 18 or older" }
        },
        {
          "id": "news_check",
          "type": "net.noodl.controls.checkbox",
          "label": "Newsletter opt-in",
          "parent": "root",
          "parameters": { "useLabel": true, "label": "Email me the newsletter" }
        },
        {
          "id": "offers_check",
          "type": "net.noodl.controls.checkbox",
          "label": "Offers opt-in",
          "parent": "root",
          "parameters": { "useLabel": true, "label": "Email me special offers" }
        },
        {
          "id": "email_note",
          "type": "Text",
          "label": "Email notice",
          "parent": "root",
          "parameters": { "text": "We will only email you what you asked for. Unsubscribe anytime." }
        },
        {
          "id": "submit_button",
          "type": "net.noodl.controls.button",
          "label": "Submit",
          "parent": "root",
          "parameters": { "label": "Create account" }
        },
        {
          "id": "all_required",
          "type": "And",
          "label": "All required consents?"
        },
        {
          "id": "any_email",
          "type": "Or",
          "label": "Any email opt-in?"
        }
      ],
      "connections": [
        { "fromId": "terms_check", "fromProperty": "checked", "toId": "all_required", "toProperty": "input 0" },
        { "fromId": "age_check", "fromProperty": "checked", "toId": "all_required", "toProperty": "input 1" },
        { "fromId": "all_required", "fromProperty": "result", "toId": "submit_button", "toProperty": "enabled" },
        { "fromId": "news_check", "fromProperty": "checked", "toId": "any_email", "toProperty": "input 0" },
        { "fromId": "offers_check", "fromProperty": "checked", "toId": "any_email", "toProperty": "input 1" },
        { "fromId": "any_email", "fromProperty": "result", "toId": "email_note", "toProperty": "visible" }
      ]
    }
  ]
}
