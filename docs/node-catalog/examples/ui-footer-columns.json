              "unit": "px"
            },
            "smallLayout": "1"
          },
          "parent": "shell",
          "children": [
            "brand",
            "nav_repeater"
          ]
        },
        {
          "id": "brand",
          "type": "Group",
          "label": "Brand",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "column",
            "rowGap": "var(--space-3)"
          },
          "parent": "top",
          "children": [
            "wordmark",
            "blurb"
          ]
        },
        {
          "id": "wordmark",
          "type": "Text",
