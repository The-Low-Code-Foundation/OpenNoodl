{
  "id": "agent-store-shared-state",
  "title": "Shared state: one store read by two unrelated components",
  "description": "Two components that are not parent and child, sharing state through a named store instead of prop drilling or a Send/Receive Event pair. Sign In writes `user` with Set Global Store; Header declares the same store by name and renders `state` — no wiring runs between the two components, because naming the store is what connects them. Header also subscribes to just the `user` key, so a write to any other key does not wake it, and uses `previousValue` against `value` to fire only on the signed-out → signed-in transition rather than on every change. Initial State fills gaps without overwriting live state, so Header remounting cannot reset a store Sign In is already using.",
  "demonstrates": ["net.noodl.GlobalStore", "net.noodl.GlobalStore.Set", "net.noodl.GlobalStore.Subscribe"],
  "components": [
    {
      "name": "/Sign In",
      "nodes": [
        {
          "id": "signin_root",
          "type": "Group",
          "label": "Sign in",
          "parameters": { "flexDirection": "column" },
          "children": ["email_input", "signin_button"]
        },
        { "id": "email_input", "type": "net.noodl.controls.textinput", "label": "Email", "parent": "signin_root" },
        { "id": "signin_button", "type": "net.noodl.controls.button", "label": "Sign in", "parent": "signin_root" },
        {
          "id": "write_user",
          "type": "net.noodl.GlobalStore.Set",
          "label": "Write user to store",
          "parameters": { "storeName": "app", "key": "user", "transaction": false }
        }
      ],
      "connections": [
        { "fromId": "email_input", "fromProperty": "text", "toId": "write_user", "toProperty": "value" },
        { "fromId": "signin_button", "fromProperty": "onClick", "toId": "write_user", "toProperty": "set" }
      ]
    },
    {
      "name": "/Header",
      "nodes": [
        {
          "id": "header_root",
          "type": "Group",
          "label": "Header",
          "parameters": { "flexDirection": "row" },
          "children": ["user_text"]
        },
        { "id": "user_text", "type": "Text", "label": "Signed in as", "parent": "header_root" },
        {
          "id": "app_store",
          "type": "net.noodl.GlobalStore",
          "label": "App store",
          "parameters": { "storeName": "app", "persist": true, "storageKey": "nodegx.example.app" }
        },
        {
          "id": "watch_user",
          "type": "net.noodl.GlobalStore.Subscribe",
          "label": "Watch user only",
          "parameters": { "storeName": "app", "keys": "user" }
        },
        { "id": "greeting", "type": "String Format", "label": "Format greeting" }
      ],
      "connections": [
        { "fromId": "watch_user", "fromProperty": "value", "toId": "greeting", "toProperty": "input" },
        { "fromId": "greeting", "fromProperty": "result", "toId": "user_text", "toProperty": "text" }
      ]
    }
  ]
}
