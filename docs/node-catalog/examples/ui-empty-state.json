          "id": "page",
          "type": "Page",
          "label": "Orders",
          "parameters": {
            "title": "Orders",
            "urlPath": "orders"
          },
          "children": [
            "band"
          ]
        },
        {
          "id": "band",
          "type": "Group",
          "label": "Page band",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "column",
            "alignItems": "center",
            "backgroundColor": "var(--background)",
            "paddingTop": "var(--space-16)",
            "paddingBottom": "var(--space-16)"
          },
          "parent": "page",
          "children": [
            "shell"
          ]
        },
        {
          "id": "shell",
          "type": "Group",
          "label": "Centred shell",
          "parameters": {
