      "value-Standard-css-class": "markdown-standard"
     }
    },
    {
     "id": "css-definition",
     "type": "CSS Definition",
     "parameters": {
      "style": "@font-face {\n    font-family: 'PlusJakartaSans';\n    src: url('fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Regular.ttf') format('truetype');\n}\n\n.markdown-standard {\n    font-family: 'PlusJakartaSans', sans-serif;\n    font-size: 16px;\n    color: #000;\n    text-align: left;\n    vertical-align: top;\n    padding: 0; /* This removes any padding */\n}\n\n.markdown-standard p {\n    margin: 0; /* Override default paragraph margins */\n}"
     }
    }
