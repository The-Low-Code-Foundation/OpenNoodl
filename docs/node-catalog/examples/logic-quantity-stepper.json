{
  "id": "logic-quantity-stepper",
  "title": "Quantity stepper: Counter with remapped and formatted readouts",
  "description": "Two buttons drive a Counter up and down within limits. The count feeds three displays: a String Format caption ('{count} items'), a String Mapper that maps special values to words (0 \u2192 'empty'), and a Number Remapper converting the 0\u201310 range into 0.2\u20131 opacity for a fill indicator. Counter holds the state; the display nodes are pure value-shaping between it and the UI. \u26a0\ufe0f This component has no `Component Inputs` or `Component Outputs`: nothing outside it can set the starting quantity or read the count back, so it is a demonstration of the value-shaping nodes rather than a part a page can use. `comp-controlled-quantity-stepper` is the same idea with an interface \u2014 `value` in, `value` and `valueChanged` out.",
  "demonstrates": ["Counter", "Number Remapper", "String Format", "String Mapper"],
  "components": [
    {
      "name": "/Quantity Stepper",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Stepper row",
          "parameters": { "flexDirection": "row", "alignItems": "center" },
          "children": ["minus_btn", "qty_text", "plus_btn", "fill_circle", "hint_text"]
        },
        { "id": "minus_btn", "type": "net.noodl.controls.button", "label": "Minus", "parent": "root", "parameters": { "label": "-" } },
        { "id": "qty_text", "type": "Text", "label": "Quantity readout", "parent": "root" },
        { "id": "plus_btn", "type": "net.noodl.controls.button", "label": "Plus", "parent": "root", "parameters": { "label": "+" } },
        { "id": "fill_circle", "type": "Circle", "label": "Fill indicator", "parent": "root", "parameters": { "size": 24 } },
        { "id": "hint_text", "type": "Text", "label": "Hint", "parent": "root" },
        {
          "id": "qty_counter",
          "type": "Counter",
          "label": "Quantity",
          "parameters": { "startValue": 1, "limitsEnabled": true, "limitsMin": 0, "limitsMax": 10 }
        },
        {
          "id": "qty_caption",
          "type": "String Format",
          "label": "Caption",
          "parameters": { "format": "{count} items" }
        },
        {
          "id": "qty_word",
          "type": "String Mapper",
          "label": "Zero to word",
          "parameters": { "defaultMapping": "in stock" }
        },
        {
          "id": "qty_opacity",
          "type": "Number Remapper",
          "label": "Count to opacity",
          "parameters": { "minInputValue": 0, "maxInputValue": 10, "minOutputValue": 0.2, "maxOutputValue": 1, "clamp": true }
        }
      ],
      "connections": [
        { "fromId": "plus_btn", "fromProperty": "onClick", "toId": "qty_counter", "toProperty": "increase" },
        { "fromId": "minus_btn", "fromProperty": "onClick", "toId": "qty_counter", "toProperty": "decrease" },
        { "fromId": "qty_counter", "fromProperty": "currentCount", "toId": "qty_caption", "toProperty": "count" },
        { "fromId": "qty_caption", "fromProperty": "formatted", "toId": "qty_text", "toProperty": "text" },
        { "fromId": "qty_counter", "fromProperty": "currentCount", "toId": "qty_word", "toProperty": "inputString" },
        { "fromId": "qty_word", "fromProperty": "mappedString", "toId": "hint_text", "toProperty": "text" },
        { "fromId": "qty_counter", "fromProperty": "currentCount", "toId": "qty_opacity", "toProperty": "inputValue" },
        { "fromId": "qty_opacity", "fromProperty": "remappedValue", "toId": "fill_circle", "toProperty": "opacity" }
      ]
    }
  ]
}
