{
  "id": "ui-form-field",
  "title": "Form field: label, control, error and hint as one reusable component",
  "description": "The unit every form is made of, built once as a component and instantiated. A column Group at --space-2 rhythm holds a label Text, the Text Input control, an error line and a hint line. ⚠️ THE TRAP: net.noodl.controls.textinput ships sizeMode \"contentSize\", and in that mode the width port is INERT — measured inside a 592px card, a field left at the default renders 196px wide (the browser's intrinsic 170px input plus its padding) at 1280px AND at 390px, never once responding to its container. Set sizeMode to \"contentHeight\" and the same width 100% measures 526px on desktop and 276px on phone. sizeMode \"explicit\" also frees the width but takes the height port with it, so a field that should grow with its own padding and font wants \"contentHeight\". ⚠️ THE SECOND TRAP, and the reason the error line is wired to `mounted` and NOT to `visible`: `visible` sets visibility:hidden and KEEPS the space it occupies (see its own port description), so an error line hidden that way leaves a permanent hole under the control. `mounted` removes the element from the page entirely. Measured: the no-error field is 71px with `mounted` and 87px with `visible` — 16px of dead row under every clean control. Both are still falsiness with no logic node: the same string drives the Text's `text` and its `mounted`, so \"\" both empties the line and takes it out of the layout. ⚠️ It only fires if something DRIVES the port — an instance that simply omits `error` never sends anything, `mounted` keeps its default true, and the line renders as an empty box; that is why every instance here passes error and hint explicitly, empty string included. ⚠️ The error line is --red-700, not --destructive: --destructive is a FILL colour, and as 14px text on --surface it measures 3.60:1 and fails AA, where --red-700 measures 6.18:1. The control's ring is --border-control (3.62:1 on --background), the token that exists because --border does not clear 3:1. The interface is the point — every port on Component Inputs is plugged \"output\", which is what makes it a component INPUT, and the typed value leaves through a Component Outputs port plugged \"input\". This is the LAYOUT recipe: for validating a value before acting on it see validate-before-submit, and for the whole control set see ctl-settings-form.",
  "demonstrates": [
    "net.noodl.controls.textinput",
    "Component Inputs",
    "Component Outputs",
    "Group",
    "Text"
  ],
  "components": [
    {
      "name": "/Pages/Example",
      "nodes": [
        {
          "id": "page",
          "type": "Page",
          "label": "Account details",
          "parameters": {
            "title": "Account details",
            "urlPath": "account"
          },
          "children": ["band"]
        },
        {
          "id": "band",
          "type": "Group",
          "label": "Band",
          "parameters": {
            "width": { "value": 100, "unit": "%" },
            "sizeMode": "contentHeight",
            "flexDirection": "column",
            "alignItems": "center",
            "backgroundColor": "var(--background)",
            "paddingTop": "var(--space-16)",
            "paddingBottom": "var(--space-16)"
          },
          "parent": "page",
          "children": ["shell"]
        },
        {
          "id": "shell",
          "type": "Group",
          "label": "Shell",
          "parameters": {
            "width": { "value": 100, "unit": "%" },
            "maxWidth": { "value": 640, "unit": "px" },
            "sizeMode": "contentHeight",
            "flexDirection": "column",
            "paddingLeft": "var(--space-6)",
            "paddingRight": "var(--space-6)"
          },
          "parent": "band",
          "children": ["form_card"]
        },
        {
          "id": "form_card",
          "type": "Group",
          "label": "Form card",
          "parameters": {
            "width": { "value": 100, "unit": "%" },
            "sizeMode": "contentHeight",
            "flexDirection": "column",
            "rowGap": "var(--space-5)",
            "backgroundColor": "var(--surface)",
            "borderRadius": "var(--radius-xl)",
            "borderStyle": "solid",
            "borderWidth": "var(--border-1)",
            "borderColor": "var(--border)",
            "paddingTop": "var(--space-8)",
            "paddingBottom": "var(--space-8)",
            "paddingLeft": "var(--space-8)",
            "paddingRight": "var(--space-8)"
          },
          "parent": "shell",
          "children": ["f_name", "f_email", "f_code"]
        },
        {
          "id": "f_name",
          "type": "/Components/FormField",
          "label": "Name field — a hint, no error",
          "parameters": {
            "label": "Full name",
            "placeholder": "Ada Lovelace",
            "hint": "As it appears on your card.",
            "error": ""
          },
          "parent": "form_card"
        },
        {
          "id": "f_email",
          "type": "/Components/FormField",
          "label": "Email field — in error",
          "parameters": {
            "label": "Email address",
            "placeholder": "you@example.com",
            "hint": "",
            "error": "Enter an address we can actually reach you at."
          },
          "parent": "form_card"
        },
        {
          "id": "f_code",
          "type": "/Components/FormField",
          "label": "Code field — neither line, and the column closes up",
          "parameters": {
            "label": "Discount code",
            "placeholder": "Optional",
            "hint": "",
            "error": ""
          },
          "parent": "form_card"
        }
      ],
      "connections": []
    },
    {
      "name": "/Components/FormField",
      "nodes": [
        {
          "id": "field",
          "type": "Group",
          "label": "Field",
          "parameters": {
            "width": { "value": 100, "unit": "%" },
            "sizeMode": "contentHeight",
            "flexDirection": "column",
            "rowGap": "var(--space-2)"
          },
          "children": ["field_label", "field_input", "field_error", "field_hint"]
        },
        {
          "id": "field_label",
          "type": "Text",
          "label": "Label",
          "parameters": {
            "text": "Label",
            "fontSize": "var(--text-sm)",
            "fontWeight": "var(--font-medium)",
            "color": "var(--foreground)"
          },
          "parent": "field"
        },
        {
          "id": "field_input",
          "type": "net.noodl.controls.textinput",
          "label": "Control — sizeMode contentHeight is what makes width 100% real",
          "parameters": {
            "sizeMode": "contentHeight",
            "width": { "value": 100, "unit": "%" },
            "type": "text",
            "placeholder": "Type here",
            "backgroundColor": "var(--background)",
            "color": "var(--foreground)",
            "fontSize": "var(--text-base)",
            "borderStyle": "solid",
            "borderWidth": "var(--border-1)",
            "borderColor": "var(--border-control)",
            "borderRadius": "var(--radius-md)",
            "paddingTop": "var(--space-3)",
            "paddingBottom": "var(--space-3)",
            "paddingLeft": "var(--space-3)",
            "paddingRight": "var(--space-3)"
          },
          "parent": "field"
        },
        {
          "id": "field_error",
          "type": "Text",
          "label": "Error line — unmounted while the error is empty, so it costs no row",
          "parameters": {
            "text": "",
            "fontSize": "var(--text-sm)",
            "color": "var(--red-700)",
            "lineHeight": "var(--leading-snug)"
          },
          "parent": "field"
        },
        {
          "id": "field_hint",
          "type": "Text",
          "label": "Hint line — same mechanism",
          "parameters": {
            "text": "",
            "fontSize": "var(--text-xs)",
            "color": "var(--muted-foreground)",
            "lineHeight": "var(--leading-snug)"
          },
          "parent": "field"
        },
        {
          "id": "field_in",
          "type": "Component Inputs",
          "label": "Field interface in — every port plugged \"output\"",
          "x": 40,
          "y": 40,
          "ports": [
            { "name": "label", "plug": "output", "type": "string" },
            { "name": "placeholder", "plug": "output", "type": "string" },
            { "name": "value", "plug": "output", "type": "string" },
            { "name": "error", "plug": "output", "type": "string" },
            { "name": "hint", "plug": "output", "type": "string" }
          ]
        },
        {
          "id": "field_out",
          "type": "Component Outputs",
          "label": "Field interface out — every port plugged \"input\"",
          "x": 640,
          "y": 40,
          "ports": [
            { "name": "text", "plug": "input", "type": "string" },
            { "name": "submitted", "plug": "input", "type": "signal" }
          ]
        }
      ],
      "connections": [
        { "fromId": "field_in", "fromProperty": "label", "toId": "field_label", "toProperty": "text" },
        { "fromId": "field_in", "fromProperty": "placeholder", "toId": "field_input", "toProperty": "placeholder" },
        { "fromId": "field_in", "fromProperty": "value", "toId": "field_input", "toProperty": "startValue" },
        { "fromId": "field_in", "fromProperty": "error", "toId": "field_error", "toProperty": "text" },
        { "fromId": "field_in", "fromProperty": "error", "toId": "field_error", "toProperty": "mounted" },
        { "fromId": "field_in", "fromProperty": "hint", "toId": "field_hint", "toProperty": "text" },
        { "fromId": "field_in", "fromProperty": "hint", "toId": "field_hint", "toProperty": "mounted" },
        { "fromId": "field_input", "fromProperty": "onTextChanged", "toId": "field_out", "toProperty": "text" },
        { "fromId": "field_input", "fromProperty": "onEnter", "toId": "field_out", "toProperty": "submitted" }
      ]
    }
  ]
}
