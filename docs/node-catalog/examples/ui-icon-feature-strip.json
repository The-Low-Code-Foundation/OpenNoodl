{
  "id": "ui-icon-feature-strip",
  "title": "Icon feature strip: three reassurances on a bordered band",
  "description": "A short horizontal band that breaks up a long page and carries the three things a visitor wants to know. Each item is an Icon plus a two-line copy stack, and the row is UNWRAPPED so the three items shrink to share the shell evenly. The icons are the accent colour and small (18–20px); the titles are --text-sm semibold and the bodies --text-sm muted. The band sits on --surface with hairlines top and bottom so it reads as a rule across the page rather than another section.",
  "demonstrates": [
    "Group",
    "net.noodl.visual.icon",
    "Text"
  ],
  "components": [
    {
      "name": "/Components/TrustStrip",
      "nodes": [
        {
          "id": "band",
          "type": "Group",
          "label": "Strip band",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "column",
            "alignItems": "center",
            "backgroundColor": "var(--surface)",
            "borderTopStyle": "solid",
            "borderTopWidth": "var(--border-1)",
            "borderTopColor": "var(--border)",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "var(--border-1)",
            "borderBottomColor": "var(--border)",
            "paddingTop": "var(--space-8)",
            "paddingBottom": "var(--space-8)"
          },
          "children": [
            "shell"
          ]
        },
        {
          "id": "shell",
          "type": "Group",
          "label": "Shell",
