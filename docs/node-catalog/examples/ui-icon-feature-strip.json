{
  "id": "ui-icon-feature-strip",
  "title": "Icon feature strip: one item component, instantiated three times inside a Columns",
  "description": "Three reassurances on a bordered band — and the shape this recipe is really about. The item is its OWN component with Component Inputs for its icon, title and body, instantiated three times; writing the subtree out three times is a `repeated-sibling-subtree` warning, not a style preference. The row is a Columns node so it collapses to one column under 700px: a Group row cannot, because no Group in the runtime has a breakpoint. The band sits on --surface with hairlines top and bottom so it reads as a rule across the page rather than another section.",
  "demonstrates": [
    "net.noodl.visual.columns",
    "net.noodl.visual.icon",
    "Text",
    "Component Inputs",
    "Group"
  ],
  "components": [
    {
      "name": "/Components/TrustStrip",
      "nodes": [
        {
          "id": "band",
          "type": "Group",
          "label": "Strip band",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "column",
            "alignItems": "center",
            "backgroundColor": "var(--surface)",
            "borderTopStyle": "solid",
            "borderTopWidth": "var(--border-1)",
            "borderTopColor": "var(--border)",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "var(--border-1)",
            "borderBottomColor": "var(--border)",
            "paddingTop": "var(--space-8)",
            "paddingBottom": "var(--space-8)"
          },
          "children": [
            "shell"
          ]
        },
        {
          "id": "shell",
          "type": "Group",
          "label": "Shell",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "maxWidth": {
              "value": 1200,
              "unit": "px"
            },
            "flexDirection": "column",
            "paddingLeft": "var(--space-6)",
            "paddingRight": "var(--space-6)"
          },
          "parent": "band",
          "children": [
            "cols"
          ]
        },
        {
          "id": "cols",
          "type": "net.noodl.visual.columns",
          "label": "Three up, collapsing",
          "parameters": {
            "layoutString": "1 1 1",
            "marginX": {
              "value": 48,
              "unit": "px"
            },
            "smallBreakpoint": {
              "value": 700,
              "unit": "px"
            },
            "smallLayout": "1"
          },
          "parent": "shell",
          "children": [
            "i1",
            "i2",
            "i3"
          ]
        },
        {
          "id": "i1",
          "type": "/Components/TrustItem",
          "label": "Delivery",
          "parameters": {
            "title": "Free UK delivery",
            "body": "On every order over £75, sent next working day.",
            "iconName": "truck"
          },
          "parent": "cols"
        },
        {
          "id": "i2",
          "type": "/Components/TrustItem",
          "label": "Small runs",
          "parameters": {
            "title": "Made in small runs",
            "body": "Between 20 and 60 of a thing, then we move on.",
            "iconName": "hammer"
          },
          "parent": "cols"
        },
        {
          "id": "i3",
          "type": "/Components/TrustItem",
          "label": "Returns",
          "parameters": {
            "title": "30-day returns",
            "body": "Use it, live with it. Send it back if it is not right.",
            "iconName": "rotate-ccw"
          },
          "parent": "cols"
        }
      ],
      "connections": []
    },
    {
      "name": "/Components/TrustItem",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Item",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "row",
            "columnGap": "var(--space-3)",
            "alignItems": "flex-start"
          },
          "children": [
            "icon",
            "copy"
          ]
        },
        {
          "id": "icon",
          "type": "net.noodl.visual.icon",
          "label": "Icon",
          "parameters": {
            "iconIconSource": {
              "class": "lucide",
              "code": "icon-truck",
              "codeAsClass": true
            },
            "iconSize": {
              "value": 20,
              "unit": "px"
            },
            "iconColor": "var(--primary)"
          },
          "parent": "root"
        },
        {
          "id": "copy",
          "type": "Group",
          "label": "Copy",
          "parameters": {
            "width": {
              "value": 100,
              "unit": "%"
            },
            "flexDirection": "column",
            "rowGap": "var(--space-1)"
          },
          "parent": "root",
          "children": [
            "t",
            "b"
          ]
        },
        {
          "id": "t",
          "type": "Text",
          "label": "Title",
          "parameters": {
            "text": "Title",
            "fontSize": "var(--text-sm)",
            "fontWeight": "var(--font-semibold)",
            "color": "var(--foreground)"
          },
          "parent": "copy"
        },
        {
          "id": "b",
          "type": "Text",
          "label": "Body",
          "parameters": {
            "text": "Body",
            "fontSize": "var(--text-sm)",
            "lineHeight": "var(--leading-normal)",
            "color": "var(--muted-foreground)"
          },
          "parent": "copy"
        },
        {
          "id": "inputs",
          "type": "Component Inputs",
          "label": "What varies per item",
          "x": 40,
          "y": 40,
          "ports": [
            {
              "name": "title",
              "plug": "output",
              "type": "*"
            },
            {
              "name": "body",
              "plug": "output",
              "type": "*"
            },
            {
              "name": "iconName",
              "plug": "output",
              "type": "*"
            }
          ]
        }
      ],
      "connections": [
        {
          "fromId": "inputs",
          "fromProperty": "title",
          "toId": "t",
          "toProperty": "text"
        },
        {
          "fromId": "inputs",
          "fromProperty": "body",
          "toId": "b",
          "toProperty": "text"
        }
      ]
    }
  ]
}
