{
  "id": "cloud-byob-live-refresh",
  "title": "A list that keeps itself current, with Subscribe To Changes",
  "description": "A query is a snapshot — it only refreshes when `Do` fires. Turning on **Subscribe To Changes** closes that gap on the Query Records node itself: it holds a live subscription on the collection and fires `Changed` whenever any client creates, updates or deletes a record, so wiring `Changed` → `Do` keeps the list current without polling. `Subscribed` drives a small 'live' indicator so people can see when realtime updates are actually running, and `Realtime Status` says which of connecting/subscribed/interrupted it is in. Works on every backend whose descriptor allows it — SSE on the built-in backend and PocketBase, a WebSocket on Directus.",
  "demonstrates": ["DbCollection2"],
  "components": [
    {
      "name": "/Live Notes",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Live notes",
          "parameters": { "flexDirection": "column" },
          "children": ["live_badge", "notes_repeater"]
        },
        { "id": "live_badge", "type": "Text", "label": "Live indicator", "parent": "root", "parameters": { "text": "● live" } },
        { "id": "notes_repeater", "type": "For Each", "label": "Notes", "parent": "root", "parameters": { "template": "/Note Row" } },
        {
          "id": "notes_query",
          "type": "DbCollection2",
          "label": "Notes",
          "parameters": { "collectionName": "Note", "realtimeEnabled": true }
        }
      ],
      "connections": [
        { "fromId": "notes_query", "fromProperty": "items", "toId": "notes_repeater", "toProperty": "items" },
        { "fromId": "notes_query", "fromProperty": "changed", "toId": "notes_query", "toProperty": "storageFetch" },
        { "fromId": "notes_query", "fromProperty": "subscribed", "toId": "live_badge", "toProperty": "visible" }
      ]
    },
    {
      "name": "/Note Row",
      "nodes": [
        { "id": "row", "type": "Group", "label": "Row", "parameters": { "flexDirection": "row" }, "children": ["title_text"] },
        { "id": "title_text", "type": "Text", "label": "Title", "parent": "row" },
        { "id": "row_inputs", "type": "Component Inputs", "label": "Record in" }
      ],
      "connections": [{ "fromId": "row_inputs", "fromProperty": "title", "toId": "title_text", "toProperty": "text" }]
    }
  ]
}
