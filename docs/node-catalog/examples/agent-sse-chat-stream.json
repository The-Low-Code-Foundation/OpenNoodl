{
  "id": "agent-sse-chat-stream",
  "title": "Agent chat: stream an AI answer token by token",
  "description": "The core agentic-UI wiring. Server-Sent Events POSTs the prompt with an Authorization header — which needs the Fetch transport, since EventSource can neither POST nor set headers — and each streamed token lands on `data`. Text Accumulator collects them with an empty delimiter, so `accumulated` is the answer as it is being written, and `changed` repaints the Text node. `connectionState` drives a status label, so a reconnection is visible rather than looking like a stalled answer, and `onOpen` clears the accumulator when a new response starts.",
  "demonstrates": ["net.noodl.SSE", "net.noodl.TextAccumulator"],
  "components": [
    {
      "name": "/Agent Chat",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Chat",
          "parameters": { "flexDirection": "column" },
          "children": ["status_text", "answer_text", "prompt_input", "send_button"]
        },
        { "id": "status_text", "type": "Text", "label": "Connection status", "parent": "root" },
        { "id": "answer_text", "type": "Text", "label": "Answer", "parent": "root" },
        { "id": "prompt_input", "type": "net.noodl.controls.textinput", "label": "Prompt", "parent": "root" },
        { "id": "send_button", "type": "net.noodl.controls.button", "label": "Send", "parent": "root" },
        {
          "id": "prompt_body",
          "type": "Javascript2",
          "label": "Build request body"
        },
        {
          "id": "chat_stream",
          "type": "net.noodl.SSE",
          "label": "Chat stream",
          "parameters": {
            "url": "https://api.example.com/chat/stream",
            "transport": "fetch",
            "method": "POST",
            "autoReconnect": true,
            "reconnectOnStreamEnd": false,
            "reconnectDelay": 1000
          }
        },
        {
          "id": "answer_accumulator",
          "type": "net.noodl.TextAccumulator",
          "label": "Collect tokens",
          "parameters": { "delimiter": "", "maxLength": 200000 }
        },
        {
          "id": "state_label",
          "type": "String Mapper",
          "label": "State to label"
        }
      ],
      "connections": [
        { "fromId": "prompt_input", "fromProperty": "text", "toId": "prompt_body", "toProperty": "prompt" },
        { "fromId": "send_button", "fromProperty": "onClick", "toId": "prompt_body", "toProperty": "run" },
        { "fromId": "prompt_body", "fromProperty": "body", "toId": "chat_stream", "toProperty": "body" },
        { "fromId": "prompt_body", "fromProperty": "headers", "toId": "chat_stream", "toProperty": "headers" },
        { "fromId": "prompt_body", "fromProperty": "send", "toId": "chat_stream", "toProperty": "connect" },
        { "fromId": "chat_stream", "fromProperty": "onOpen", "toId": "answer_accumulator", "toProperty": "clear" },
        { "fromId": "chat_stream", "fromProperty": "data", "toId": "answer_accumulator", "toProperty": "chunk" },
        { "fromId": "chat_stream", "fromProperty": "onMessage", "toId": "answer_accumulator", "toProperty": "add" },
        { "fromId": "answer_accumulator", "fromProperty": "accumulated", "toId": "answer_text", "toProperty": "text" },
        { "fromId": "chat_stream", "fromProperty": "connectionState", "toId": "state_label", "toProperty": "input" },
        { "fromId": "state_label", "fromProperty": "output", "toId": "status_text", "toProperty": "text" }
      ]
    }
  ]
}
