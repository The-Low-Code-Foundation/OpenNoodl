                    {
                        "id": "7a1e5b30-4c11-9d20-b3f2-000000000011",
                        "type": "JavaScriptFunction",
                        "label": "Make 10k rows",
                        "x": -560,
                        "y": 40,
                        "parameters": {
                            "functionScript": "// Generates 10,000 demo rows — the array the Virtual List windows over.\n// No inputs; runs once. Every value is built locally, nothing external.\nconst count = 10000;\nconst firstNames = ['Ada', 'Grace', 'Alan', 'Edsger', 'Barbara', 'Donald', 'Radia', 'Katherine', 'Vint', 'Margaret'];\nconst lastNames = ['Lovelace', 'Hopper', 'Turing', 'Dijkstra', 'Liskov', 'Knuth', 'Perlman', 'Johnson', 'Cerf', 'Hamilton'];\nconst rows = new Array(count);\nfor (let i = 0; i < count; i++) {\n    const name = firstNames[i % firstNames.length] + ' ' + lastNames[Math.floor(i / firstNames.length) % lastNames.length];\n    rows[i] = {\n        name: name,\n        email: name.toLowerCase().split(' ').join('.') + '.' + i + '@example.com'\n    };\n}\nOutputs.Rows = rows;"
                        },
                        "ports": [],
                        "dynamicports": [
                            {
                                "name": "out-Rows",
                                "displayName": "Rows",
                                "plug": "output",
                                "type": "*",
                                "group": "Outputs",
                                "index": 1
                            }
                        ],
                        "children": [],
                        "metadata": {
                            "merge": {
