                    {
                        "id": "7a1e5b30-4c11-9d20-b3f2-000000000016",
                        "type": "JavaScriptFunction",
                        "label": "Status text",
                        "x": -560,
                        "y": 260,
                        "parameters": {
                            "functionScript": "// Every input is guarded: an unconnected input arrives as undefined.\nconst first = typeof Inputs.First === 'number' ? Inputs.First : 0;\nconst count = typeof Inputs.Count === 'number' ? Inputs.Count : 0;\nOutputs.Text = 'First visible row: ' + first + ' · rows intersecting the viewport: ' + count;"
                        },
