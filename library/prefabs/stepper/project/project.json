            "type": "JavaScriptFunction",
            "label": "Step view",
            "x": -400,
            "y": 40,
            "parameters": {
              "functionScript": "// Colour is the only thing that carries state here, so it is derived once\n// and never restated in the graph.\nconst state = String(Inputs.State || 'todo');\nconst done = state === 'done';\nconst current = state === 'current';\n\nOutputs.ShowNumber = !done;\nOutputs.ShowTick = done;\nOutputs.CircleColor = done || current ? 'var(--primary)' : 'var(--muted)';\nOutputs.NumberColor = current ? 'var(--primary-foreground)' : 'var(--muted-foreground)';\nOutputs.TitleColor = current ? 'var(--foreground)' : 'var(--muted-foreground)';\n"
            },
