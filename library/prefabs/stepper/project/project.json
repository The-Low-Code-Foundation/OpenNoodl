            "type": "JavaScriptFunction",
            "label": "Advance",
            "x": -460,
            "y": 460,
            "parameters": {
              "functionScript": "// Runs only when Next is pressed. Both value inputs have \"Run on value\n// change\" unticked (runOnChange-in-Count / -in-Max) \u2014 with them ticked this\n// node re-runs whenever the count moves, which is *immediately after it moved\n// it*, and the stepper runs to the end on one click.\nconst count = Number(Inputs.Count || 0);\nconst max = Number(Inputs.Max || 0);\nif (count < max) Outputs.Step();\nelse Outputs.Finish();\n",
              "runOnChange-in-Count": false,
              "runOnChange-in-Max": false
            },
