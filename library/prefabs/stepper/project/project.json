          {
            "id": "57e99000-1000-4000-9000-000000000003",
            "type": "JavaScriptFunction",
            "label": "Stepper model",
            "x": -460,
            "y": 140,
            "parameters": {
              "functionScript": "// One pass over the steps, so the rail, the buttons and the limits all agree.\nconst asArray = (v) => (Array.isArray(v) ? v : v && Array.isArray(v.items) ? v.items : []);\nconst connected = asArray(Inputs.Items);\nconst steps = connected.length > 0 ? connected : asArray(Inputs.Samples);\nconst count = Math.max(0, Number(Inputs.Current || 0));\nconst last = Math.max(0, steps.length - 1);\nconst current = Math.min(count, last);\n\nOutputs.Steps = steps.map((step, i) => ({\n  ...step,\n  Index: i,\n  Number: String(i + 1),\n  // \"done\" is behind you, \"current\" is here, \"todo\" is ahead. The Step\n  // component paints from this and nothing else.\n  State: i < current ? 'done' : i === current ? 'current' : 'todo',\n  IsLast: i === last\n}));\n\nOutputs.Max = last;\nOutputs.Current = current;\nOutputs.CanBack = current > 0;\nOutputs.IsLast = current >= last;\nOutputs.NextLabel = current >= last ? 'Finish' : 'Next';\nOutputs.Progress = steps.length === 0 ? '' : 'Step ' + (current + 1) + ' of ' + steps.length;\n"
            },
