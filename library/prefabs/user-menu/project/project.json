          {
            "id": "05e40000-1000-4000-9000-000000000007",
            "type": "JavaScriptFunction",
            "label": "Menu view",
            "x": -220,
            "y": 760,
            "parameters": {
              "functionScript": "// The chevron swaps GLYPH rather than rotating — Lucide has no rotation port,\n// and a swap reads correctly with animation turned off. Straight out of the\n// Accordion entry.\n//\n// This node is allowed never to run at load. Its only input is the Switch's\n// state, and if the Switch does not publish until it first changes then this\n// stays unrun — which is why the Chevron icon's own parameter is already the\n// CLOSED glyph. Whichever way the runtime behaves, a freshly loaded menu shows\n// a chevron pointing down.\nconst open = Inputs.Open === true;\n\nOutputs.Chevron = {\n  class: 'lucide',\n  code: open ? 'icon-chevron-up' : 'icon-chevron-down',\n  codeAsClass: true\n};\n"
            },
