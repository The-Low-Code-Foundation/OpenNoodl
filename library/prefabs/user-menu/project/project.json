          },
          {
            "id": "05e40000-1000-4000-9000-000000000003",
            "type": "JavaScriptFunction",
            "label": "Choose user",
            "x": -520,
            "y": 100,
            "parameters": {
              "functionScript": "// Who the menu is about. A sample person ships with the prefab so it shows what\n// it is the moment it is placed, exactly as Card Grid and Avatar Group do.\n//\n// This Function is also the boot anchor for the whole entry: `Sample` arrives\n// from a Static Data node at load, so it HAS run — with a real answer — before\n// anybody clicks anything. Nothing here is ever a first-click-eaten-as-boot-run.\nconst text = (v) => {\n  if (v === undefined || v === null) return '';\n  return typeof v === 'string' ? v.trim() : String(v).trim();\n};\n\nconst name = text(Inputs.Name);\nconst email = text(Inputs.Email);\nconst image = text(Inputs.Avatar);\n\n// All-or-nothing, not field-by-field. The moment ANY of the three is connected\n// with a value this is a real person and the sample is gone. Falling back per\n// field instead would leave the sample's PHOTO attached to your user's NAME\n// while you were half way through wiring it up, which reads as a bug in the\n// prefab rather than as an unfinished graph.\nconst real = name !== '' || email !== '' || image !== '';\n\nconst asArray = (v) => (Array.isArray(v) ? v : v && Array.isArray(v.items) ? v.items : []);\nconst sample = asArray(Inputs.Sample)[0] || {};\n\nconst user = real\n  ? { Name: name, Email: email, Avatar: image }\n  : { Name: text(sample.Name), Email: text(sample.Email), Avatar: text(sample.Avatar) };\n\n// \"Ada Lovelace\" -> AL, \"ada.lovelace\" -> AL, \"Ada\" -> AD, \"\" -> ?\n// The same rule the Avatar prefab uses, so a project holding both never shows\n// one person two different ways.\nfunction initials(value) {\n  if (!value) return '?';\n  const bySpace = value.split(' ').filter(Boolean);\n  const byDot = value.split('.').filter(Boolean);\n  const parts = bySpace.length > byDot.length ? bySpace : byDot;\n  const first = parts[0] || '';\n  const second = parts[1] || '';\n  if (!first) return '?';\n  if (!second) return first.substring(0, 2).toUpperCase();\n  return (first[0] + second[0]).toUpperCase();\n}\n\nOutputs.Name = user.Name;\nOutputs.Email = user.Email;\nOutputs.Avatar = user.Avatar;\nOutputs.HasImage = user.Avatar !== '';\nOutputs.NoImage = user.Avatar === '';\nOutputs.Initials = initials(user.Name);\nOutputs.HasEmail = user.Email !== '';\n// An unconnected boolean Component Input arrives as undefined, not as its\n// default, so the default lives here: details ON unless you turn them off.\nOutputs.ShowDetails = Inputs.ShowDetails !== false;\n"
            },
