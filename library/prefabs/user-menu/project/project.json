            "label": "Sample menu items",
            "x": -860,
            "y": 560,
            "parameters": {
              "type": "json",
              "json": "[\n    {\n        \"Label\": \"Your profile\",\n        \"Icon\": \"user\"\n    },\n    {\n        \"Label\": \"Account settings\",\n        \"Icon\": \"settings\"\n    },\n    {\n        \"Label\": \"Billing\",\n        \"Icon\": \"credit-card\"\n    },\n    {\n        \"Label\": \"Notifications\",\n        \"Icon\": \"bell\"\n    }\n]"
            },
            "ports": [],
            "dynamicports": [],
            "children": []
          },
          {
            "id": "05e40000-1000-4000-9000-000000000005",
            "type": "JavaScriptFunction",
            "label": "Choose items",
            "x": -520,
            "y": 520,
            "parameters": {
              "functionScript": "// A connected, non-empty Items array wins over the samples. Same contract as\n// Card Grid, Accordion and Avatar Group.\nconst asArray = (v) => (Array.isArray(v) ? v : v && Array.isArray(v.items) ? v.items : []);\nconst connected = asArray(Inputs.Items);\nconst items = connected.length > 0 ? connected : asArray(Inputs.Samples);\n\n// 🔴 The icon OBJECT is stamped here, not authored per row.\n//\n// A Lucide icon source is THREE fields and `codeAsClass` is the one that is\n// easy to leave out — without it the glyph's NAME renders as visible text, and\n// that shipped on this shelf for six weeks. Rows carry a bare name\n// (\"credit-card\") and this makes the object, so a row CANNOT be written wrong.\n// Same reasoning as Avatar Group stamping `Overlap` onto each row: the thing\n// that has to be exactly right belongs in one place, not in every caller.\nconst toIconSource = (value) => {\n  const raw = String(value === undefined || value === null ? '' : value).trim();\n  if (raw === '') return undefined;\n  return {\n    class: 'lucide',\n    code: raw.indexOf('icon-') === 0 ? raw : 'icon-' + raw,\n    codeAsClass: true\n  };\n};\n\nOutputs.Items = items.map((item) => {\n  const row = item && typeof item === 'object' ? item : {};\n  const source = toIconSource(row.Icon !== undefined ? row.Icon : row.icon);\n  return Object.assign({}, row, {\n    Label: String(row.Label === undefined || row.Label === null ? '' : row.Label),\n    'Icon Source': source,\n    'Has Icon': source !== undefined\n  });\n});\n\nconst signOut = typeof Inputs.SignOutLabel === 'string' ? Inputs.SignOutLabel.trim() : '';\nOutputs.SignOutLabel = signOut !== '' ? signOut : 'Sign out';\n"
            },
