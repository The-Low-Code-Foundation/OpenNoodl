          {
            "id": "05e40000-1000-4000-9000-000000000002",
            "type": "Static Data",
            "label": "Sample user",
            "x": -860,
            "y": 320,
            "parameters": {
              "type": "json",
              "json": "[\n    {\n        \"Name\": \"Alexandra Morgan\",\n        \"Email\": \"alexandra.morgan@example.com\",\n        \"Avatar\": \"noodl_modules/starter-imagery/avatar-2.webp\"\n    }\n]"
            },
