          {
            "id": "133e0104-accb-231e-2857-454c494b82c6",
            "type": "Javascript2",
            "x": 247,
            "y": -46,
            "parameters": {
              "code": "Node.Setters.mediaQuery = function(value) {\n    \n    if(this.query) {\n        this.query.removeListener(this.listener);\n    }\n    \n    this.listener = query => {\n      if (query.matches) {\n        Node.setOutputs({match: true, noMatch: false});\n      } else {\n        Node.setOutputs({match: false, noMatch: true});\n      }\n    }\n    \n    this.query = window.matchMedia(value);\n    this.listener(this.query);\n    this.query.addListener(this.listener);\n    \n}\n\nNode.OnDestroy = function() {\n    if(this.query) {\n        this.query.removeListener(this.listener);\n        this.query = undefined;\n        this.listener = undefined;\n    }\n}",
              "scriptInputs": [
