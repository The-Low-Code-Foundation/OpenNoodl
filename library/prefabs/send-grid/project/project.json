                    {
                        "id": "573d7ec3-a6a4-115b-1321-815bcaa073d2",
                        "type": "JavaScriptFunction",
                        "x": -0.5,
                        "y": 16,
                        "parameters": {
                            "functionScript": "const html = Inputs.Html;\nconst text = Inputs.Text;\nconst to = Inputs.To;\nconst cc = Inputs.CC;\nconst bcc = Inputs.BCC;\nconst from = Inputs.From;\nconst subject = Inputs.Subject;\nconst apiKey = Inputs.APIKey;\n\nif(apiKey === undefined || apiKey === \"\") {\n    Outputs.Failure()\n    throw Error(\"No API Key provided!\")\n}\n\nconst personalizations = [\n    { \"to\": (Array.isArray(to)?to.map(e => ({email:e}) ):[{\"email\": to}]) }\n]\n\nif(cc !== undefined) {\n    personalizations[0][\"cc\"] = (Array.isArray(cc)?cc.map(e => ({email:e}) ):[{\"email\": cc}])\n}\n\nif(bcc !== undefined) {\n    personalizations[0][\"bcc\"] = (Array.isArray(bcc)?bcc.map(e => ({email:e}) ):[{\"email\": bcc}]) \n\n}\n\nconst res = await fetch(\"https://api.sendgrid.com/v3/mail/send\",{\n    method:'POST',\n    headers:{\n        \"Authorization\":\"Bearer \" + apiKey,\n        \"Content-Type\":\"application/json\"\n    },\n    body:JSON.stringify({\n    personalizations,\n    \"from\": {\"email\":from},\n    \"subject\": subject,\n    \"content\": (html!==undefined)?\n     [{\"type\": \"text/html\", \"value\": html}]:\n    [{\"type\": \"text/plain\", \"value\": text}]\n    \n    })\n})\n\nif(res.ok) {\n    Outputs.Success()\n}\nelse {\n    Outputs.Failure()\n    const json = await res.json()\n    throw Error(json.errors.map(e => e.message).join('\\n'))\n}",
