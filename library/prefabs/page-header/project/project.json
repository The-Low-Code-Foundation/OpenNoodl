                    {
                        "id": "3f8a1c00-9b2d-4e01-a1f0-0d5b7c9e0012",
                        "type": "JavaScriptFunction",
                        "label": "Prepare crumbs",
                        "x": -360,
                        "y": 160,
                        "parameters": {
                            "functionScript": "// Shape the breadcrumb array for the repeater.\n// Every input is guarded: an unconnected input arrives as undefined.\nconst source = Array.isArray(Inputs.Breadcrumbs) ? Inputs.Breadcrumbs : [];\nOutputs.Crumbs = source.map(function (crumb, index) {\n    const safe = crumb && typeof crumb === 'object' ? crumb : {};\n    return {\n        label: safe.label === undefined || safe.label === null ? '' : String(safe.label),\n        target: safe.target === undefined || safe.target === null ? '' : String(safe.target),\n        isLast: index === source.length - 1,\n        showSeparator: index < source.length - 1\n    };\n});\nOutputs.HasCrumbs = source.length > 0;\nconst subtitle = typeof Inputs.Subtitle === 'string' ? Inputs.Subtitle.trim() : '';\nOutputs.HasSubtitle = subtitle.length > 0;"
                        },
                        "ports": [],
