          {
            "id": "5ea2c000-1000-4000-9000-000000000002",
            "type": "JavaScriptFunction",
            "label": "Emit query",
            "x": -160,
            "y": 40,
            "parameters": {
              "functionScript": "// Runs when the Timer finishes, not when a key goes down: this node's\n// \"Run on value change\" is unticked for Text (runOnChange-in-Text), so the\n// only thing that runs it is the debounce completing.\nconst query = String(Inputs.Text || '').trim();\n\n// Outputs reads back what was last published \u2014 the proxy only traps writes.\n// Every Function runs once at boot, and a search bar that announces a change\n// before anybody typed makes every listener run a query for \"\". So the first\n// run establishes the baseline and stays quiet; only a real move signals.\nconst previous = Outputs.Query === undefined ? '' : Outputs.Query;\nOutputs.Query = query;\nif (query !== previous) Outputs.Changed();\n",
              "runOnChange-in-Text": false
            },
            "ports": [],
            "dynamicports": [
