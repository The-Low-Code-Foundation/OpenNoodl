          {
            "id": "5ea2c000-1000-4000-9000-000000000003",
            "type": "JavaScriptFunction",
            "label": "Field view",
            "x": -160,
            "y": 260,
            "parameters": {
              "functionScript": "// The live view of the field, on every keystroke \u2014 separate from the\n// debounced Query on purpose. A clear button that waits 300ms to appear\n// after you type would feel broken.\nconst text = String(Inputs.Text || '');\nconst count = Inputs.Count;\nconst hasCount = count !== undefined && count !== null && count !== '';\n\nOutputs.HasText = text.length > 0;\nOutputs.ShowCount = hasCount && text.length > 0;\nOutputs.CountLabel = hasCount\n  ? Number(count) === 1 ? '1 result' : Number(count).toLocaleString() + ' results'\n  : '';\n"
            },
