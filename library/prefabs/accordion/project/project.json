          {
            "id": "acc07000-1000-4000-9000-000000000002",
            "type": "Static Data",
            "label": "Sample sections",
            "x": -720,
            "y": 240,
            "parameters": {
              "type": "json",
              "json": "[\n    {\n        \"Title\": \"What is a prefab?\",\n        \"Body\": \"A prefab is a project you install into your own. Its components land in your component tree and you edit them like anything else you drew \\u2014 there is no black box and nothing to un-eject.\"\n    },\n    {\n        \"Title\": \"Does it use my theme?\",\n        \"Body\": \"Yes, when it is written to. Colours and spacing here come from design tokens, so an installed prefab picks up the host project's palette instead of carrying this one's.\"\n    },\n    {\n        \"Title\": \"Can I open more than one at a time?\",\n        \"Body\": \"Each section owns its own state, so yes \\u2014 opening one never closes another.\"\n    }\n]"
            },
            "ports": [],
            "dynamicports": [],
            "children": []
          },
          {
            "id": "acc07000-1000-4000-9000-000000000003",
            "type": "JavaScriptFunction",
            "label": "Choose items",
            "x": -400,
            "y": 140,
            "parameters": {
              "functionScript": "// A connected, non-empty Items array wins over the samples, so the accordion\n// shows what it is the moment it is placed. Same contract as Card Grid.\nconst asArray = (v) => (Array.isArray(v) ? v : v && Array.isArray(v.items) ? v.items : []);\nconst connected = asArray(Inputs.Items);\nOutputs.Items = connected.length > 0 ? connected : asArray(Inputs.Samples);\n"
            },
            "ports": [],
