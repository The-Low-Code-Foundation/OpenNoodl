          {
            "id": "acc07000-1000-4000-9000-000000000042",
            "type": "JavaScriptFunction",
            "label": "Open or closed",
            "x": -400,
            "y": 40,
            "parameters": {
              "functionScript": "// Open when the click count is odd \u2014 flipped if the section was asked to\n// start open. A COUNT rather than a remembered boolean, and that is the whole\n// design:\n//\n// \ud83d\udd34 A Function that toggles `Outputs.IsOpen` has to know whether it has ever\n// run, and it has not. Its only input here would be `Start Open`, which is\n// normally unset, so no value ever arrives and the node never runs at boot \u2014\n// the first click becomes the missing boot run and does nothing. Measured: the\n// drive had to click a header TWICE to open it, once per section, and the\n// third click on row 0 was the one that worked.\n//\n// Counting removes the question. `Clicks` arrives at 0 on load, so this runs\n// with a real answer before anybody touches it, and `Start Open` works without\n// a boot run to seed it.\nconst clicks = Number(Inputs.Clicks || 0);\nconst open = (clicks % 2 === 1) !== (Inputs.StartOpen === true);\n\nOutputs.IsOpen = open;\nOutputs.IsClosed = !open;\n// Lucide has no rotation port, so the chevron is two glyphs rather than one\n// turned \u2014 which also means it reads correctly with animation disabled.\nOutputs.Chevron = {\n  class: 'lucide',\n  code: open ? 'icon-chevron-down' : 'icon-chevron-right',\n  codeAsClass: true\n};\n"
            },
            "ports": [],
            "dynamicports": [
              {
                "name": "in-Clicks",
                "displayName": "Clicks",
                "plug": "input",
                "type": "number",
                "group": "Inputs",
                "index": 0
              },
