          {
            "id": "fnFn",
            "type": "JavaScriptFunction",
            "children": [],
            "label": "Join and initial",
            "x": 420,
            "y": 60,
            "parameters": {
              "functionScript": "var first = String(Inputs.firstName == null ? '' : Inputs.firstName).trim();\nvar last = String(Inputs.lastName == null ? '' : Inputs.lastName).trim();\n// A single field holding 'Ada Lovelace' is the commonest real shape of this data;\n// splitting it here is why the initials come out AL rather than A.\nif (!last && first.indexOf(' ') !== -1) {\n  var bits = first.split(/\\s+/);\n  last = bits.pop();\n  first = bits.join(' ');\n}\nvar parts = [];\nif (first) parts.push(first);\nif (last) parts.push(last);\nvar fallback = String(Inputs.fallback == null ? '' : Inputs.fallback).trim();\nOutputs.hasName = parts.length > 0;\nOutputs.fullName = parts.length ? parts.join(' ') : fallback;\nvar letters = [];\nfor (var i = 0; i < parts.length; i++) letters.push(parts[i].charAt(0).toUpperCase());\nOutputs.initials = letters.join('') || fallback.charAt(0).toUpperCase();"
            },
