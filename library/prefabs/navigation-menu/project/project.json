                        "type": "JavaScriptFunction",
                        "label": "Keep track of current url",
                        "x": -295,
                        "y": -66,
                        "parameters": {
                            "functionScript": "const onUrlChange = () => {\n    // Send the current pathname as an output\n    Outputs.PathName = document.location.pathname\n}\n\n// Detect a change of the pathname\nif (window.history && window.history.pushState) {\n    window.addEventListener('popstate', onUrlChange)\n} else {\n    window.addEventListener('hashchange', onUrlChange)\n}\n\nonUrlChange()"
