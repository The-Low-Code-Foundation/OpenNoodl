            "parameters": {
              "type": "json",
              "json": "[\n    {\n        \"Title\": \"Ship your first page\",\n        \"Body\": \"Cards flow into as many columns as fit. Resize the window and watch them wrap.\",\n        \"Footer\": \"Guide · 5 min\"\n    },\n    {\n        \"Title\": \"Connect real data\",\n        \"Body\": \"Point the Items input at any array — records, a REST response, or a Function output.\",\n        \"Footer\": \"Data\"\n    },\n    {\n        \"Title\": \"Optional media\",\n        \"Body\": \"Give an item an Image property (a URL or a project file) and the card grows a media area on top.\"\n    },\n    {\n        \"Title\": \"Optional footer\",\n        \"Body\": \"Items without a Footer property render without the footer strip — like this one.\"\n    },\n    {\n        \"Title\": \"Click handling\",\n        \"Body\": \"Every card emits Clicked; the grid forwards it together with the clicked card's title and item id.\",\n        \"Footer\": \"Signals\"\n    },\n    {\n        \"Title\": \"One column when narrow\",\n        \"Body\": \"Below one card width the grid degrades to a single full-width column instead of overflowing.\",\n        \"Footer\": \"Responsive\"\n    }\n]"
            },
            "ports": [],
            "dynamicports": [],
            "children": []
          },
