            "id": "ca4d0000-2000-4000-9000-000000000003",
            "type": "JavaScriptFunction",
            "label": "Choose items",
            "x": -420,
            "y": 120,
            "parameters": {
              "functionScript": "// A non-empty connected Items array wins over the Static Data samples.\n// Every input is guarded: an unconnected input is undefined.\nconst asArray = (v) => Array.isArray(v) ? v : (v && Array.isArray(v.items) ? v.items : []);\nconst connected = asArray(Inputs.Items);\nOutputs.Items = connected.length > 0 ? connected : asArray(Inputs.Fallback);\n"
            },
