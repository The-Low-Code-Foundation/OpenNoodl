                    {
                        "id": "9bc7761a-6f3a-adad-f621-ae420312dd6d",
                        "type": "JavaScriptFunction",
                        "x": 5,
                        "y": -107,
                        "parameters": {
                            "functionScript": "const params = {\n    client_id:Inputs.ClientId,\n    client_secret:Inputs.ClientSecret,\n    grant_type:'authorization_code',\n    code:Inputs.Code,\n    redirect_uri:Inputs.RedirectUri,\n    scope:Inputs.Scope\n}\n\nconst query = Object.keys(params).map(key => key + \"=\" + params[key]).join('&')\n\nconst res = await fetch(Inputs.TokenEndpoint,{\n    method:'POST',\n    headers:{\n        'content-type':'application/x-www-form-urlencoded',\n        'content-length':query.length,\n    },\n    body:query,\n})\n\nif(res.ok) {\n    const json = await res.json()\n\n    // We have an access token\n    const accessToken = json.access_token;\n    if(!accessToken) {\n        Outputs.Failure()\n        throw Error(\"No access token in response\")\n    }\n\n    const oauthUser = await fetch(Inputs.UserEndpoint,{\n        method:'GET',\n        headers:{\n            Authorization:'Bearer ' + accessToken\n        }  \n    })\n\n    if(oauthUser.ok) {\n        const userJson = await oauthUser.json()\n\n        const email = userJson[Inputs.EmailField];\n        if(!accessToken) {\n            Outputs.Failure()\n            throw Error(\"No email found in user response.\")\n        }\n\n        const users = await Noodl.Records.query(\"_User\",{\n            email:{equalTo:email}\n        })\n\n        if(users && users.length === 1) {\n            // We already have a user, add to auth data\n            // great, impersonate and return\n            const _user = await Noodl.Users.impersonate(users[0].username)\n            Outputs.SessionToken = _user.sessionToken;\n            Outputs.Success()\n        }\n        else if(!users || users.length === 0) {\n            // There is no user, create one\n            const _user = await Noodl.Records.create(\"_User\",{\n                username:email,\n                email:email,\n                password:(Math.random() + 1).toString(36).substring(7), // Random fire and forget password\n            },{\n                acl:{\n                    '*':{read:false,write:false}\n                }\n            })\n            Outputs.SessionToken = _user.sessionToken;\n            Outputs.Success()\n        }\n    }\n    else {\n        Outputs.Failure();\n        throw Error(\"Failed to fetch user from user endpoint.\")\n    }\n}\nelse {\n    Outputs.Failure();\n    throw Error(\"Failed to fetch token with authorization code.\")\n}"
                        },
                        "ports": [],
