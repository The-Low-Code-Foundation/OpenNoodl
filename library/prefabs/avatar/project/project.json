          {
            "id": "ava70000-1000-4000-9000-000000000022",
            "type": "Static Data",
            "label": "Sample people",
            "x": -700,
            "y": 240,
            "parameters": {
              "type": "json",
              "json": "[\n    {\n        \"Name\": \"Ada Lovelace\",\n        \"Image\": \"noodl_modules/starter-imagery/avatar-1.webp\"\n    },\n    {\n        \"Name\": \"Grace Hopper\",\n        \"Image\": \"noodl_modules/starter-imagery/avatar-2.webp\"\n    },\n    {\n        \"Name\": \"Alan Turing\",\n        \"Image\": \"\"\n    },\n    {\n        \"Name\": \"Katherine Johnson\",\n        \"Image\": \"noodl_modules/starter-imagery/avatar-3.webp\"\n    },\n    {\n        \"Name\": \"Radia Perlman\",\n        \"Image\": \"\"\n    }\n]"
            },
            "ports": [],
            "dynamicports": [],
            "children": []
          },
          {
            "id": "ava70000-1000-4000-9000-000000000023",
            "type": "JavaScriptFunction",
            "label": "Choose items",
            "x": -380,
            "y": 140,
            "parameters": {
              "functionScript": "// A connected, non-empty Items array wins over the sample people, so the\n// prefab shows something the moment it is placed and shows *your* data the\n// moment you wire it. Same contract as Card Grid's \"Choose items\".\nconst asArray = (v) => (Array.isArray(v) ? v : v && Array.isArray(v.items) ? v.items : []);\nconst connected = asArray(Inputs.Items);\nconst items = connected.length > 0 ? connected : asArray(Inputs.Samples);\n\nconst max = Number(Inputs.Max) > 0 ? Number(Inputs.Max) : items.length;\nconst overlap = Number(Inputs.Overlap) >= 0 ? Number(Inputs.Overlap) : 10;\nconst shown = items.slice(0, max);\nconst hidden = items.length - shown.length;\n\n// Overlap rides on the row, because `styleCss` cannot express \"every child\n// after the first\": it applies declarations to one element, not rules. The\n// first avatar sits flush; the rest slide back over the one before.\nOutputs.Items = shown.map((item, i) => ({\n  ...item,\n  Overlap: i === 0 ? { value: 0, unit: 'px' } : { value: -overlap, unit: 'px' }\n}));\nOutputs.BadgeOverlap = shown.length === 0 ? { value: 0, unit: 'px' } : { value: -overlap, unit: 'px' };\nOutputs.Overflow = hidden > 0 ? '+' + hidden : '';\nOutputs.HasOverflow = hidden > 0;\n"
            },
