          {
            "id": "ava70000-1000-4000-9000-000000000002",
            "type": "JavaScriptFunction",
            "label": "Avatar model",
            "x": -380,
            "y": 40,
            "parameters": {
              "functionScript": "// Everything the view needs, decided once. Every input is guarded: an\n// unconnected Component Input arrives as undefined, not as its default.\nconst size = Number(Inputs.Size) > 0 ? Number(Inputs.Size) : 40;\nconst src = String(Inputs.Image || '').trim();\nconst name = String(Inputs.Name || '').trim();\n\n// \"Ada Lovelace\" -> AL, \"ada.lovelace\" -> AL, \"Ada\" -> AD, \"\" -> ?\nfunction initials(value) {\n  if (!value) return '?';\n  const bySpace = value.split(' ').filter(Boolean);\n  const byDot = value.split('.').filter(Boolean);\n  const parts = bySpace.length > byDot.length ? bySpace : byDot;\n  const first = parts[0] || '';\n  const second = parts[1] || '';\n  if (!first) return '?';\n  if (!second) return first.substring(0, 2).toUpperCase();\n  return (first[0] + second[0]).toUpperCase();\n}\n\nOutputs.HasImage = src !== '';\nOutputs.NoImage = src === '';\nOutputs.Initials = initials(name);\nOutputs.Box = size;\n// The letters track the circle rather than being a second thing to set.\nOutputs.FontSize = Math.max(10, Math.round(size * 0.38));\n"
            },
