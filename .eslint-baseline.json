{
  "targets": [
    "packages/noodl-editor/src"
  ],
  "maxErrors": 3916,
  "byRule": {
    "no-shadow-restricted-names": 2,
    "@typescript-eslint/no-this-alias": 835,
    "no-cond-assign": 236,
    "no-empty": 150,
    "no-useless-escape": 312,
    "no-undef": 386,
    "@typescript-eslint/no-var-requires": 194,
    "@typescript-eslint/ban-ts-comment": 67,
    "@typescript-eslint/no-unused-vars": 867,
    "no-redeclare": 54,
    "no-case-declarations": 16,
    "no-extra-boolean-cast": 6,
    "no-control-regex": 13,
    "no-misleading-character-class": 13,
    "no-regex-spaces": 1,
    "no-func-assign": 82,
    "no-unsafe-finally": 47,
    "getter-return": 2,
    "no-fallthrough": 128,
    "react/display-name": 8,
    "react/no-find-dom-node": 35,
    "no-sparse-arrays": 4,
    "valid-typeof": 8,
    "no-self-assign": 1,
    "@typescript-eslint/no-explicit-any": 114,
    "@typescript-eslint/ban-types": 4,
    "prefer-const": 4,
    "no-var": 142,
    "no-inner-declarations": 15,
    "prefer-rest-params": 2,
    "prefer-spread": 1,
    "no-extra-semi": 1,
    "no-constant-condition": 2,
    "react/no-unescaped-entities": 10,
    "react/prop-types": 147,
    "react-hooks/exhaustive-deps": 1,
    "react/jsx-no-target-blank": 1,
    "react/no-unknown-property": 2,
    "no-empty-pattern": 2,
    "react/jsx-key": 1
  }
}
