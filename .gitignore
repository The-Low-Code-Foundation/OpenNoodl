# Build files
releases/*
build-tmp
dist-cli
packages/noodl-cloud-services/build/*

# Editor build artifacts.
#
# These are webpack output, regenerated by `npm run build:editor` (production)
# and `npm run dev` (main process). They were committed until REV-008, which is
# how a months-old bundle could silently run instead of the source next to it.
# `scripts/check-build-artefacts.js` fails the build if any of them come back.
#
# Renderer + main entry points:
packages/noodl-editor/src/editor/index.bundle.js
packages/noodl-editor/src/editor/index.bundle.js.map
packages/noodl-editor/src/frames/viewer-frame/index.bundle.js
packages/noodl-editor/src/frames/viewer-frame/index.bundle.js.map
packages/noodl-editor/src/main/main.bundle.js
# Split chunks, Monaco workers and file-loader SVGs, all emitted into the
# package root by webpackconfigs/*. Scoped to the package root rather than a
# bare `*.bundle.js` so a real source file named `*.bundle.js` deeper in the
# tree would still be tracked.
packages/noodl-editor/*.bundle.js
packages/noodl-editor/*.bundle.js.map
packages/noodl-editor/*.worker.js
packages/noodl-editor/*.worker.js.map
packages/noodl-editor/*.svg

# Test files (build artifacts - bundle outputs and leaked SVG assets)
packages/noodl-editor/tests/css.worker.js
packages/noodl-editor/tests/editor.worker.js
packages/noodl-editor/tests/index.bundle.js
packages/noodl-editor/tests/ts.worker.js
packages/noodl-editor/tests/node_modules_*.bundle.js
packages/noodl-editor/tests/vendors-*.bundle.js
packages/noodl-editor/tests/*.svg
packages/noodl-editor/tests/test-results.json

# Other
packages/noodl-editor/src/external
.github/.secrets
packages/noodl-viewer-cloud/publish

# Local dev/debug logs (scripts/devtools/dev-debug.js)
.logs/

# Dev main-process source map (webpack.main.dev.js) — see "Editor build
# artifacts" above for the rest of the generated output.
packages/noodl-editor/src/main/main.bundle.js.map

# LIB-001: library:build output — a build artifact generated from library/,
# not source. Publishing copies it into the docs repo; see library/README.md.
/library-dist/
project-tmp.json*
__MACOSX

# Generated by `npm run build:types` in packages/noodl-runtime (PLAT-006).
# `noodl-viewer-react` resolves @noodl/runtime types from here rather than compiling the
# runtime's sources inside its own ESM program; regenerated by every build that needs it.
packages/noodl-runtime/dist-types/

# Output of the F20 box-sizing probe (regenerated per run)
dev-docs/tasks/phase-23-visual-refresh/corpus/boxsizing-impact.json

# uba-e2e rig: esbuild output of the live drivers. The .ts sources and the
# recorded run outputs are tracked; the bundles are regenerated by build-*.mjs.
dev-docs/tasks/phase-16-runtime-deploy-health/uba-e2e/*.cjs
